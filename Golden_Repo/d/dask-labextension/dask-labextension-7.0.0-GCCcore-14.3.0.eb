# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'dask-labextension'
version = '7.0.0'

homepage = "https://github.com/dask/dask-labextension"

description = """
JupyterLab extension for Dask.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatch-jupyter-builder', '0.9.1'),
]
dependencies = [
    ('Python', '3.13.5'),
    ('JupyterLab', '4.5.5'),
    ('jupyter-server-proxy', '20260302'),
    ('dask', '2025.9.1', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('nodejs', '22.17.1'),
]

exts_list = [
    ('dask_labextension', version, {
        'checksums': ['45a60bd0ad31c5e425986b7e40a5aa242aa582ea868025ac2b82d0aa16ffcb8a'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
