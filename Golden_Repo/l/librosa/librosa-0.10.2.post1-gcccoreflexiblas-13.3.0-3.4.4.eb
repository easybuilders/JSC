    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-Stack', '2024a'),
    ('FFmpeg', '7.0.2'),
    ('numba', '0.60.0'),
    ('libsndfile', '1.2.2'),
    ('scikit-learn', '1.5.2'),
    ('scikit-image', '0.25.0'),
]

