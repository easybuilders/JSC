# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'Meld'
version = '3.22.2'

homepage = 'http://meldmerge.org'
description = """
 Meld is a visual diff and merge tool targeted at developers. Meld helps you compare files, directories,
 and version controlled projects
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = [FTPGNOME_SOURCE]
sources = [SOURCELOWER_TAR_XZ]
checksums = ['46a0a713fbcd1b153b377a1e0757c8ce255c9822467658eacfbd89b1e92316ef']

builddependencies = [
    ('binutils', '2.42'),
    ('intltool', '0.51.0'),
]

dependencies = [
    ('GLib', '2.80.4'),
    ('Python', '3.12.3'),
    ('PyCairo', '1.27.0'),
    ('PyGObject', '3.48.2'),
    ('GTK3', '3.24.42'),
    ('GtkSourceView', '4.8.0'),
]

moduleclass = 'tools'
