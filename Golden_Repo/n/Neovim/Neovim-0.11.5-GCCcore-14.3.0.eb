# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'Neovim'
version = '0.11.5'

homepage = 'http://neovim.io'
description = """Vim-fork focused on extensibility and usability"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/neovim/neovim/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']

checksums = ['c63450dfb42bb0115cd5e959f81c77989e1c8fd020d5e3f1e6d897154ce8b771']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]
dependencies = [
    ('libiconv', '1.18'),
    ('pynvim', '0.6.0'),
]

skipsteps = ['configure']
build_cmd = 'make CMAKE_BUILD_TYPE=Release CMAKE_EXTRA_FLAGS="-DCMAKE_INSTALL_PREFIX=%(installdir)s"'

sanity_check_paths = {
    'files': ['bin/nvim'],
    'dirs': ['lib'],
}

moduleclass = 'tools'
