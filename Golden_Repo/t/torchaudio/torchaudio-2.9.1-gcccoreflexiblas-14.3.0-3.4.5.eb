# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'torchaudio'
version = '2.9.1'

homepage = 'https://github.com/pytorch/audio'
description = """ Data manipulation and transformation for audio signal
processing, powered by PyTorch """

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}

# Torchaudio is completely dependent on the right version of PyTorch
# so we download from the same source_url as PyTorch

source_urls = ['https://download.pytorch.org/whl/cu128/']


if ARCH == 'aarch64':
    sources = ['%(name)s-%(version)s-cp313-cp313-manylinux_2_28_%(arch)s.whl']
    checksums = ['ea6fe3b9525493df0a5eb5eed5c22925065b5830f6999980ed76bb36c4592d34']
else:
    sources = ['%(name)s-%(version)s%2Bcu128-cp313-cp313-manylinux_2_28_%(arch)s.whl']
    checksums = ['52297b7dfb7c42e311385572bc9c0186e602ea1a5f20c42923765baea99aff83']

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-Stack', '2025b'),
    ('CUDA', '13', '', SYSTEM),
    ('PyTorch', '2.9.1'),
    ('SoX', '14.4.2'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('librosa', '0.11.0'),
]
preinstallopts = 'export USE_FFMPEG=1; export TORCH_CUDA_ARCH_LIST=%(cuda_cc_semicolon_sep)s; '

moduleclass = 'lib'
