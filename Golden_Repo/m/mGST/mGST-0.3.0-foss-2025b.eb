# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'mGST'
version = '0.3.0'

homepage = 'https://github.com/rabrie/mGST'
description = """This repository contains the Python implementation of a flexible
and efficient gate set tomography technique based on low-rank approximations,
as described in the following research paper:

Title: Compressive gate set tomography
Authors: Raphael Brieger, Ingo Roth, and Martin Kliesch
"""

toolchain = {'name': 'foss', 'version': '2025b'}

builddependencies = [
    ('hatchling', '1.27.0'),
    ('pybind11', '3.0.0'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('CUDA', '13', '', SYSTEM),
    ('matplotlib', '3.10.5', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('numba', '0.62.0', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('plotly.py', '6.5.0'),
    ('networkx', '3.5', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('tqdm', '4.67.1'),
]

exts_list = [
    ('stim', '1.15.0', {
        'checksums': ['95236006859d6754be99629d4fb44788e742e962ac8c59caad421ca088f7350e'],
    }),
    ('pygsti', '0.9.14', {
        'checksums': ['54dc93407d1c75088507185856608a2525a8f56af43cb8ec59d0a78a347ec622'],
    }),
    (name, version, {
        'modulename': 'mGST',
        'source_tmpl': 'v%(version)s.tar.gz',
        'patches': ['remove_cython.patch'],
        'source_urls': ['https://github.com/rabrie/mGST/archive/refs/tags/'],
        'checksums': [
            {'v%(version)s.tar.gz':
             'ef4c5508a40a0599f1cbf27727af20a87aa83a4a9fe6e24a70cdc88f0fa94054'},
            {'remove_cython.patch':
             '10d3142a31619b307c6d3e1aceaa83dcc71c528158a09fd93d2a006b35b42d1e'},
        ],
    }),
]

sanity_check_paths = {
    'files': ['lib/python%(pyshortver)s/site-packages/mGST/__init__.py'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'quantum'
