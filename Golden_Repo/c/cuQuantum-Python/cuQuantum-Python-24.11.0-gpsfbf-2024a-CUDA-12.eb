# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'cuQuantum-Python'
version = '24.11.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://docs.nvidia.com/cuda/cuquantum/'
description = """NVIDIA cuQuantum SDK is a high-performance library
for quantum information science and beyond.
Currently its primary target is quantum circuit simulations and it consists
of two major components:

        cuStateVec: a high-performance library for state vector computations

        cuTensorNet: a high-performance library for tensor network computations
"""

toolchain = {'name': 'gpsfbf', 'version': '2024a'}
toolchainopts = {'pic': True}

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    # For cupy, contains numpy 1.26.4
    ('CUDA', '12', '', SYSTEM),
    ('cuQuantum', '24.11.0', '-CUDA-%(cudaver)s'),
]

# cuTENSOR and CuPy modules not used as dependencies for cuQuantum-Python
# because it requests specifically cupy-cuda12x, custatevec-cu12
# cutensornet-cu12 and cutensor-cu12 .whl files.

# fastrlock from CuPy imported as ext_list. Cupy cannot be used as a dependency
# because cupy-cuda12x is mandatory and if both are used there will be a collision
# of libraries in cuQuantum-Python module with a successful compilation and failing
# importing cuQuantum and running cuQuantum-Python scripts.

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'sanity_pip_check': True,
    'download_dep_fail': True,
    'use_pip_for_deps': False,
}

local_arch = {
    'aarch64': 'aarch64',
    'x86_64':  'x86_64'
}

exts_list = [
    ('fastrlock', '0.8.3', {
        'checksums': ['4af6734d92eaa3ab4373e6c9a1dd0d5ad1304e172b1521733c6c3b3d73c8fa5d'],
    }),
    # cutensornet-cu12 and cudensitymat-cu12 require cutensor-cu12, which is not the same as cutensor module
    ('cutensor_cu12', '2.0.2', {
        'modulename': 'cutensor',
        'source_tmpl': '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl' % local_arch[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl'
            % local_arch['aarch64']:
                '1db559bdfe4345ac19ee66ab7ee49a54e98b1529fc96de812ade3dbc0a90ef47',
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl'
            % local_arch['x86_64']:
                '18c96a4f1e8a559eec626527f5928d5f5b575f6c2b9c45e87309a025ae682334',
        }],
    }),
    ('cutensornet_cu12', '2.6.0', {
        'modulename': 'cuquantum.cutensornet',
        'source_tmpl': '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl' % local_arch[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl'
            % local_arch['aarch64']:
                '39b6f50b8bd47e5a4fcb745472c1005fc9d3889b907c92a91ea76e30a91e11cd',
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl'
            % local_arch['x86_64']:
                '64b582679c4e16faecd9143103272376e847e4b7ff02c97cde72f39ea6243f5e',
        }],
    }),
    ('custatevec_cu12', '1.7.0', {
        'modulename': 'cuquantum.custatevec',
        'source_tmpl': '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl' % local_arch[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.whl'
