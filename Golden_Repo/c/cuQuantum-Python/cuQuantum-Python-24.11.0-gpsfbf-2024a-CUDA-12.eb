    ('cuquantum_python', version, {
        'modulename': 'cuquantum',
        'checksums': ['2cb67b1c270663a206dcbda7cb74ba564c633f97ec117e6d39f5faf7597dbbcc'],
    }),
]

sanity_pip_check = True

moduleclass = 'quantum'
