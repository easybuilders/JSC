# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Toolchain'

name = 'gpsfbf'
version = '2025b'

homepage = '(none)'
description = """GNU Compiler Collection (GCC) based compiler toolchain, including
 ParaStationMPI for MPI support, FlexiBlas (BLAS and LAPACK support), FFTW and ScaLAPACK."""

toolchain = SYSTEM

local_gccver = '14.3.0'

# toolchain used to build foss dependencies
local_comp_mpi_tc = ('gpsmpi', version)

# we need GCC and psmpi as explicit dependencies instead of gpsmpi toolchain
# because of toolchain preparation functions
dependencies = [
    ('GCC', local_gccver),
    ('psmpi', '5.13.0-1', '', ('GCC', local_gccver)),  # part of gpsmpi toolchain
    ('FlexiBLAS', '3.4.5', '', ('GCC', local_gccver)),
    ('FFTW', '3.3.10', '', ('GCC', local_gccver)),
    ('FFTW.MPI', '3.3.10', '', local_comp_mpi_tc),
    ('ScaLAPACK', '2.2.2', '-fb', local_comp_mpi_tc),
]

moduleclass = 'toolchain'
