# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
##
# Author:    Robert Mijakovic <robert.mijakovic@lxp.lu>
##
name = 'CP2K'
version = '2025.2'

homepage = 'https://www.cp2k.org/'
description = """CP2K is a freely available (GPL) program, written in Fortran 95, to perform atomistic and molecular
 simulations of solid state, liquid, molecular and biological systems. It provides a general framework for different
 methods such as e.g. density functional theory (DFT) using a mixed Gaussian and plane waves approach (GPW), and
 classical pair and many-body potentials.

 Available optional features: libint, libxc, elpa, libvori, plumed, libsmeagol, spglib, dftd4, libxsmm 
 Hybrid MPI/OpenMP version 
 pure MPI:  srun --ntasks=<n> --cpus-per-task=1 --threads-per-core=1 -A <account> cp2k.psmp -i problem.inp 
 hybrid  :  srun --ntasks=<n> --cpus-per-task=<m> --threads-per-core=1 -A <account> cp2k.psmp -i problem.inp 
"""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'pic': True, 'openmp': True,
                 'usempi': True, 'verbose': False, 'shared': True}

source_urls = ['https://github.com/cp2k/cp2k/releases/download/v%(version)s/']
sources = [
    SOURCELOWER_TAR_BZ2,
    'jobregtesting.sh'
]

checksums = [
    'c8392a4e123304644ec8d241443796277c6ed7ae977452317e779f3c387c2e19',
    'e828159b679c8d78f2ca20c820890b83b1f756ad8d55b43a6460f85b5d8f2d17',
]

builddependencies = [
    ('flex', '2.6.4'),
    ('Bison', '3.8.2'),
]

dependencies = [
    ('Libint', '2.11.1', '-lmax-5-cp2k'),
    ('libxc', '7.0.0'),
    ('ELPA', '2025.06.001'),
    ('libvori', '220621'),
    ('FFTW', '3.3.10'),
    ('PLUMED', '2.9.4'),
    ('libsmeagol', '1.2'),
    ('spglib', '2.5.0'),
    ('dftd4', '3.7.0', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('libxsmm', '1.17'),
]

#   libxsmm 1.17 is explicitly configured to use MKL blas (x86_64), Openblas (aarch64)

type = 'psmp'
max_parallel = 4

# no testsuite run
# this requires about 30 minutes on a dedicated compute node of jureca-dc
# use jobscript template in $EBROOTCP2K/tests/jobregtesting.sh

sanity_check_paths = {
    'files': [
        'bin/cp2k.psmp',
        'bin/cp2k_shell.psmp',
        'tests/tests.tar.gz',
        'tests/regtestingtools.tar.gz',
        'tests/jobregtesting.sh'
    ],
    'dirs': ['bin', 'tests', 'data'],
}

postinstallcmds = [
    'mkdir %(installdir)s/tests',
    'pushd %(start_dir)s && tar -czf %(installdir)s/tests/tests.tar.gz tests && popd',
    'pushd %(start_dir)s && tar -czf %(installdir)s/tests/regtestingtools.tar.gz tools/regtesting && popd',
    'pushd %(start_dir)s && tar -czf %(installdir)s/tests/gridtests.tar.gz src/grid/sample_tasks  && popd',
    'cp %(build_dir)s/jobregtesting.sh %(installdir)s/tests/jobregtesting.sh'
]

moduleclass = 'chem'
