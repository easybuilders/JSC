easyblock = 'PythonBundle'

name = 'tvb-library'
version = '2.9.1'

homepage = "https://github.com/the-virtual-brain/tvb-root"

description = """
Main The Virtual Brain codebase. 
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('jupyter-server', '2.15.0'),
    ('numba', '0.60.0'),
    ('matplotlib', '3.9.2', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('networkx', '3.3'),
    ('Pillow-SIMD', '10.4.0'),
    ('Mako', '1.3.5'),
    ('GitPython', '3.1.43'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('wrapt', '1.16.0', {
        'checksums': ['5f370f952971e7d17c7d1ead40e49f32345a7f7a5373571ef44d800d06b1899d'],
    }),
    ('deprecated', '1.2.18', {
        'checksums': ['422b6f6d859da6f2ef57857761bfb392480502a64c3028ca9bbe86085d72115d'],
    }),
    ('pycodestyle', '2.12.1', {
        'checksums': ['6838eae08bbce4f6accd5d5572075c63626a15ee3e6f842df996bf62f6d73521'],
    }),
    ('autopep8', '2.3.1', {
        'checksums': ['8d6c87eba648fdcfc83e29b788910b8643171c395d9c4bcf115ece035b9c9dda'],
    }),
    ('tvb_library', version, {
        'modulename': 'tvb.basic',
        'checksums': ['a251f602bffe768e6184ffc14d3d6ad9f03be879a78062a7397c30a5f8878b41'],
    }),
]

moduleclass = 'tools'
