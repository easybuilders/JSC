# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'ParityOS'
version = '2.6.0'

homepage = 'https://parityqc.com/parityos'
description = """We created ParityOS with the aim to offer an all-in-one
solution to solve real-world problems on quantum computers.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

dependencies = [
    ('binutils', '2.42'),
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('matplotlib', '3.9.2', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('Pillow-SIMD', '10.4.0'),
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'sanity_pip_check': True,
    'download_dep_fail': True,
    'use_pip_for_deps': False,
}

exts_list = [
    ('parityos', version, {
        'checksums': ['505f3597da70c849084246864b20e36a196c24010b139f5207a7d032efd363f0'],
    }),
]

moduleclass = 'quantum'
