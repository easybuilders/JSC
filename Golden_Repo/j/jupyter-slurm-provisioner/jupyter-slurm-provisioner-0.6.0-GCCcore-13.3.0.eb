# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyter-slurm-provisioner'
version = '0.6.0'

homepage = 'https://github.com/FZJ-JSC/jupyter-slurm-provisioner-extension'
description = """
A JupyterLab extension for using a slurm kernel provisioner
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('JupyterLab', '4.3.4'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('jupyter-slurm-provisioner', version, {
        'checksums': ['24141dc4abfb009d424837a5d78159c2b63e0243d63618cacebcf4f23edc101f'],
    }),
    ('jupyter_slurm_provisioner_extension', '0.4.0', {
        'source_urls': [
            'https://github.com/FZJ-JSC/jupyter-slurm-provisioner-extension/releases/download/v%(version)s/'
        ],
        'sources': ['jupyter_slurm_provisioner_extension-%(version)s.tar.gz'],
        'checksums': ['fa3105daf0ed70f896c28fc7634b96d4a69cd6a8cec3dbd59bf705f412af939f'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

sanity_check_paths = {
    'files': [],
    'dirs': [
        'share/jupyter/labextensions',
        'lib/python%(pyshortver)s/site-packages'
    ],
}

moduleclass = 'tools'
