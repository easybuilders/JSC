# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
# easyconfig file for MED Library
easyblock = 'ConfigureMake'

name = 'MED'
version = '6.0.1'

homepage = 'http://salome-platform.org/'
description = """Initially defined by EDF R&D,
this format has been defined and maintained
through a MED working group comprising members of
EDF R&D and CEA (the Code Saturne team being represented).
"""

toolchain = {'name': 'gompi', 'version': '2025b'}
toolchainopts = {'optarch': True, 'pic': True, 'usempi': True}

source_urls = ['https://files.salome-platform.org/Salome/medfile/']
sources = ['med-%(version)s.tar.gz']

checksums = [
    'f8f1edc6874bc48d8f3e4e8be1cf7379ed318726d8abc6804e85e821555b1fa8'  # med-6.0.1.tar.gz
]

builddependencies = [
    ('Autotools', '20250527'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('SWIG', '4.3.1'),
    ('HDF5', '1.14.6')
]

prebuildopts = 'autoreconf -f -i && '

# better to configure these dependents explicitly
configopts = '--with-f90 '
configopts += '--with-swig=$EBROOTSWIG '
configopts += '--with-hdf5=$EBROOTHDF5 '

sanity_check_paths = {
    'files': ["bin/%s" % x for x in ["mdump", "xmdump",
              "medconforme", "medimport"]] +
             ["lib/%s" % x for x in ["libmed.a",
              "libmedimport.a", "libmedC.a"]],
    'dirs': ["include", "lib/python%(pyshortver)s/site-packages/med"],
}

moduleclass = 'lib'
