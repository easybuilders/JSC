# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'ChASE'
version = '1.7.0'

homepage = 'https://github.com/ChASE-library/ChASE'
description = """ChASE (Chebyshev Accelerated Subspace Eigensolver) is a library
for solving Hermitian and Quasi-Hermitian eigenvalue problems using Chebyshev filter-based iterative methods."""

toolchain = {'name': 'foss', 'version': '2025b'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://github.com/ChASE-library/ChASE/archive/refs/tags']
sources = [f'v{version}.tar.gz']

checksums = [
    'b19391b9d0208e5f4b768c33fee47df610eef5cc832fa7df6a8fdbb42e57462c',
]

builddependencies = [
    ('CMake', '4.0.3'),
]

dependencies = [
    ('CUDA', '13', '', SYSTEM),
]

build_type = "Release"

configopts = (
    '-DCHASE_BUILD_WITH_EXAMPLES=OFF '
    '-DCHASE_ENABLE_TESTS=OFF '
    '-DCMAKE_CUDA_ARCHITECTURES="%(cuda_cc_cmake)s" '
)

sanity_check_paths = {
    'files': ['include/Impl/pchase_cpu/pchase_cpu.hpp', 'include/Impl/chase_cpu/chase_cpu.hpp'],
    'dirs': ['include'],
}

moduleclass = 'math'
