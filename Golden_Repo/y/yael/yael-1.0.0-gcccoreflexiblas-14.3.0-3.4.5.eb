# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'yael'
version = '1.0.0'

homepage = 'https://gitlab.jsc.fz-juelich.de/gawehn1/yael/'
description = """
Yael is designed to make it east to encode quadratic unconstrained optimization
problems into QUBOs.
It therefore provides different encodings to map integers to binary
representations as well as different transformations to be able to represent
real values.

Author: Carina Gawehn
"""

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', '2025.07'),
]

source_urls = ['https://gitlab.jsc.fz-juelich.de/gawehn1/yael/-/archive/v1.0.0/']
sources = ['%(name)s-v%(version)s.tar.gz']
checksums = ['ad4942d4ca67e19b7732ebbd2c4017513e4da3b71f596d4e5884c9c18394cb4b']

preinstallopts = "export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_YAEL=1.0.0 && "

sanity_check_paths = {
    'files': ['lib/python%(pyshortver)s/site-packages/yael/__init__.py'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'quantum'
