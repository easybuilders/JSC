easyblock = 'CargoPythonBundle'

name = 'PyQuil'
version = '4.16.2'

homepage = 'https://github.com/rigetti/pyquil'
description = """PyQuil is a library for generating and executing Quil programs on the Rigetti Forest platform."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    ('poetry', '1.8.3'),
    ('maturin', '1.6.0'),
    ('Rust', '1.78.0'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('IPython', '8.27.0'),
    ('networkx', '3.3'),
    ('PyZMQ', '26.2.0'),
    ('ruamel.yaml', '0.18.6'),
    ('flit', '3.9.0'),
    ('grpcio', '1.67.1'),
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'use_pip_for_deps':  False,
    'download_dep_fail': True,
    'sanity_pip_check': True,
}

