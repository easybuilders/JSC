# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CmdCp'

name = 'Ninja'
version = '1.13.0'

homepage = 'https://ninja-build.org/'
description = "Ninja is a small build system with a focus on speed."

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/ninja-build/ninja/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['Ninja-1.13.0_enhance_GuessParallelism.patch']
checksums = [
    {'v1.13.0.tar.gz': 'f08641d00099a9e40d44ec0146f841c472ae58b7e6dd517bee3945cfd923cedf'},
    {'Ninja-1.13.0_enhance_GuessParallelism.patch': '30b09bd109ed1c42997eb57689ff776217ab2fc9df1240d784730c75d9ea234e'},
]

builddependencies = [
    ('binutils', '2.44'),
    ('Python', '3.13.5'),
]

cmds_map = [('.*', "./configure.py --bootstrap")]

files_to_copy = [(['ninja'], 'bin')]

sanity_check_paths = {
    'files': ['bin/ninja'],
    'dirs': [],
}

sanity_check_commands = ["ninja --version"]

moduleclass = 'tools'
