# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Bundle'

name = 'JupyterBundle-PyNeuroscience'
version = '20250707'
local_jupyterver = '4.3.4'
versionsuffix = '-' + local_jupyterver

homepage = "https://jupyter.org/"

description = """
 This bundles Jupyter-extensions and -kernels of the Neuroscience community.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

dependencies = [
    # JupyterLab extensions
    ('tvb-ext-bucket', '2.0.1'),
    ('tvb-ext-unicore', '3.1.1'),
    ('tvb-ext-xircuits', '2.0.1'),

    # Jupyter kernels
    ('JupyterKernel-EBrains', '24.04', '-' + local_jupyterver),
    ('JupyterKernel-VirtualBrainTwin', '25.07', '-' + local_jupyterver),

    # Jupyter proxies
    ('JupyterProxy-NESTDesktop', '0.4.0'),

    # Extras
    ('k3d', '2.16.1'),
    ('ipycanvas', '0.13.3'),
]

moduleclass = 'tools'
