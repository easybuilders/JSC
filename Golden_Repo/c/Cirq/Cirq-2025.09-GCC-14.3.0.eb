easyblock = 'PythonBundle'

name = 'Cirq'
version = '2025.09'
local_commit = 'a0115b3a00b5411af6027cbd75048c6e957cb436'
# Using local commit since latest stable Cirq release does not support
# protobuf-python/6.31.1

homepage = 'https://github.com/quantumlib/cirq'
description = """A python framework for creating, editing,
and invoking Noisy Intermediate Scale Quantum (NISQ) circuits."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.44'),
    ('poetry', '2.1.3'),
    ('maturin', '1.9.1'),
    ('hatchling', '1.27.0'),
    ('Cython', '3.1.2'),
]

