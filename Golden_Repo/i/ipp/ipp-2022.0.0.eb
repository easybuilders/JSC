# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
name = 'ipp'
version = '2022.0.0'

homepage = 'https://software.intel.com/en-us/articles/intel-ipp/'
description = """Intel Integrated Performance Primitives (Intel IPP) is an extensive library
 of multicore-ready, highly optimized software functions for multimedia, data processing,
 and communications applications. Intel IPP offers thousands of optimized functions
 covering frequently used fundamental algorithms."""

toolchain = SYSTEM

source_urls = [
    'https://registrationcenter-download.intel.com/akdlm/IRC_NAS/acf220fa-326d-4f6e-9b63-f2da47b6f680']
sources = ['intel-ipp-%(version)s.809_offline.sh']
checksums = ['e5e9be64ed79d9f3b2a11d9cdb573bea4a3a9a5cf08e5b7cc713947e622abbd6']

sanity_check_paths = {
    'files': ['ipp/2022.0/lib/intel64/libippcc.so'],
    'dirs': ['ipp/2022.0/lib', 'ipp/2022.0/include'],
}

moduleclass = 'perf'
