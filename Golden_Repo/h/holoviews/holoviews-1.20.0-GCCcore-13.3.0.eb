# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'holoviews'
version = '1.20.0'

homepage = "https://holoviews.org"

description = """
HoloViews is an open-source Python library designed to make data analysis and visualization seamless and simple.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('panel', '1.5.5'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('colorcet', '3.1.0', {
        'checksums': ['2921b3cd81a2288aaf2d63dbc0ce3c26dcd882e8c389cc505d6886bf7aa9a4eb'],
    }),
    ('holoviews', version, {
        'checksums': ['29d183045fafa3d846deda999d9687b99b8abdc1a8c06712e54afa576bb02b3e'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
