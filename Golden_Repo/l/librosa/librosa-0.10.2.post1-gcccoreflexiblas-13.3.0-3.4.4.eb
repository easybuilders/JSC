    ('nanobind', '2.4.0', {
        'checksums': ['a0392dee5f58881085b2ac8bfe8e53f74285aa4868b1472bfaf76cfb414e1c96'],
    }),
    ('audioread', '3.0.1', {
        'checksums': ['ac5460a5498c48bdf2e8e767402583a4dcd13f4414d286f42ce4379e8b35066d'],
    }),
