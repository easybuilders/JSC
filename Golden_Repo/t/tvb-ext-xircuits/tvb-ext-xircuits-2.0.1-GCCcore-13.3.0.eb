# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'tvb-ext-xircuits'
version = '2.0.1'

homepage = "https://github.com/the-virtual-brain/tvb-ext-xircuits"

description = """
Simple visual programming environment for jupyterlab.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('tqdm', '4.66.5'),
    ('pyunicore', '1.2.0'),
    ('tvb-ext-bucket', '2.0.1'),
    ('tvb-ext-unicore', '3.1.1'),
    ('tvb-library', '2.9.1'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('pygithub', '2.5.0', {
        'modulename': 'github',
        'checksums': ['e1613ac508a9be710920d26eb18b1905ebd9926aa49398e88151c1b526aad3cf'],
    }),
    ('tvb_ext_xircuits', version, {
        'modulename': False,
        'checksums': ['a53cef9891457a8c2350d43c097fbc22dac87ec66c7505681392c6691e27eba5'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
