# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'netCDF-C++4'
version = '4.3.1'
versionsuffix = '-serial'

homepage = 'https://www.unidata.ucar.edu/software/netcdf/'
description = """NetCDF (network Common Data Form) is a set of software libraries
 and machine-independent data formats that support the creation, access, and sharing of array-oriented
 scientific data."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/Unidata/netcdf-cxx4/archive/']
sources = ['v%(version)s.tar.gz']
patches = ['netCDF-C++4_nolog.patch']
checksums = [
    {'v4.3.1.tar.gz': 'e3fe3d2ec06c1c2772555bf1208d220aab5fee186d04bd265219b0bc7a978edc'},
    {'netCDF-C++4_nolog.patch': '5c0cb8f954c1b584c1a6dddbe15cbf3a78e03b4a4bd8150b18f87d273da374ea'},
]

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('netCDF', '4.9.3', '-serial'),
]

sanity_check_paths = {
    'files': ['include/netcdf', 'lib/libnetcdf_c++4.a', 'lib/libnetcdf_c++4.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'data'
