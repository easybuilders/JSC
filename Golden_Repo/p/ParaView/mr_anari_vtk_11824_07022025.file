+
+      bool isTimeVarying =
+        timeVarFunc(arrayName, vtkAnariActorNode::SCENEGRAPH_TIME_CONSTANT_CELL_ARRAYS());
+
+      attributeArrays.push_back({ cellArray, true, isTimeVarying });
