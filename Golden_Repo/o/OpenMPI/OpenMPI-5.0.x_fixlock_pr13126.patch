From 1ba62eafc2ca3de54441b1cac056afc5acf3d343 Mon Sep 17 00:00:00 2001
From: Joseph Schuchart <joseph.schuchart@stonybrook.edu>
Date: Wed, 5 Mar 2025 18:25:35 +0100
Subject: [PATCH] osc/ucx: ignore lock table if "no_locks" info key is set

Signed-off-by: Joseph Schuchart <joseph.schuchart@stonybrook.edu>
---
 ompi/mca/osc/ucx/osc_ucx_comm.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/ompi/mca/osc/ucx/osc_ucx_comm.c b/ompi/mca/osc/ucx/osc_ucx_comm.c
index 86f82697995..ab122e67263 100644
--- a/ompi/mca/osc/ucx/osc_ucx_comm.c
+++ b/ompi/mca/osc/ucx/osc_ucx_comm.c
@@ -606,6 +606,9 @@ int ompi_osc_ucx_get(void *origin_addr, size_t origin_count,
 static inline bool ompi_osc_need_acc_lock(ompi_osc_ucx_module_t *module, int target)
 {
     ompi_osc_ucx_lock_t *lock = NULL;
+    if (module->no_locks) {
+        return true; // if we have no locks we always need to acquire the accumulate lock
+    }
     opal_hash_table_get_value_uint32(&module->outstanding_locks,
                                      (uint32_t) target, (void **) &lock);
 
