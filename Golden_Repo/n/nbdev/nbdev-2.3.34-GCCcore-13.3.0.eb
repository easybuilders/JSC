# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'nbdev'
version = '2.3.34'

homepage = "https://nbdev.fast.ai"

description = """
Create delightful software with Jupyter Notebooks
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('IPython', '8.27.0'),
    ('PyYAML', '6.0.2'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('fastcore', '1.7.28', {
        'checksums': ['606e4507eb4b8892e4c83ddf5462fbcf32f4bde4fa6caf56ca67ee5e2dbe2b1e'],
    }),
    ('execnb', '0.1.11', {
        'checksums': ['ebb37688adb5434300c25867c6944b7ca0c5b003cb7f5fdacf89eb7dfe4cf8e8'],
    }),
    ('astunparse', '1.6.3', {
        'checksums': ['5ad93a8456f0d084c3456d059fd9a92cce667963232cbf763eac3bc5b7940872'],
    }),
    ('ghapi', '1.0.6', {
        'checksums': ['64fdd9f06d8e3373065c42c2a03e067e2bbb9ca18b583cd6e38a28aaad0224f6'],
    }),
    ('watchdog', '5.0.3', {
        'checksums': ['108f42a7f0345042a854d4d0ad0834b741d421330d5f575b81cb27b883500176'],
    }),
    (name, version, {
        'checksums': ['a0766337e42ee08f47c91d517804e009d85e4dfbe984951cbecee877538e4ef7'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
