From f54637a239373b9e97ab939603adf685573efc83 Mon Sep 17 00:00:00 2001
From: Jonathan Windgassen <j.windgassen@fz-juelich.de>
Date: Tue, 25 Feb 2025 14:54:04 +0100
Subject: [PATCH] Make ServerProcess.timeout a Float

---
 jupyter_server_proxy/config.py | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/jupyter_server_proxy/config.py b/jupyter_server_proxy/config.py
index 20d69070..61fd1dd5 100644
--- a/jupyter_server_proxy/config.py
+++ b/jupyter_server_proxy/config.py
@@ -16,6 +16,7 @@
     Bool,
     Callable,
     Dict,
+    Float,
     Instance,
     Int,
     List,
@@ -106,8 +107,8 @@ class ServerProcess(Configurable):
     """,
     ).tag(config=True)
 
-    timeout = Int(
-        20, help="Timeout in seconds for the process to become ready, default 5s."
+    timeout = Float(
+        20.0, help="Timeout in seconds for the process to become ready, default 5s."
     ).tag(config=True)
 
     absolute_url = Bool(
