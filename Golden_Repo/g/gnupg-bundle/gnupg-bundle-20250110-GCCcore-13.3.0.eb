# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Bundle'

name = 'gnupg-bundle'
version = '20250110'

homepage = 'https://www.gnupg.org/software/index.html'
description = """GnuPG — The Universal Crypto Engine"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [('binutils', '2.42')]

default_easyblock = 'ConfigureMake'

default_component_specs = {
    'sources': [SOURCE_TAR_BZ2],
    'start_dir': '%(name)s-%(version)s',
}

components = [
    ('libgpg-error', '1.51', {  # 2024-11-11
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/libgpg-error/'],
        'checksums': ['be0f1b2db6b93eed55369cdf79f19f72750c8c7c39fc20b577e724545427e6b2'],
    }),
    ('libassuan', '3.0.1', {  # 2024-06-24
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/libassuan/'],
        'checksums': ['c8f0f42e6103dea4b1a6a483cb556654e97302c7465308f58363778f95f194b1'],
    }),
    ('libgcrypt', '1.11.0', {  # 2024-06-17
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/libgcrypt/'],
        'checksums': ['09120c9867ce7f2081d6aaa1775386b98c2f2f246135761aae47d81f58685b9c'],
    }),
    ('libksba', '1.6.7', {  # 2024-06-21
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/libksba/'],
        'checksums': ['cf72510b8ebb4eb6693eef765749d83677a03c79291a311040a5bfd79baab763'],
    }),
    ('npth', '1.8', {  # 2024-11-12
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/npth/'],
        'checksums': ['8bd24b4f23a3065d6e5b26e98aba9ce783ea4fd781069c1b35d149694e90ca3e'],
    }),
    ('gnupg', '2.5.3', {  # 2025-01-09
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/gnupg/'],
        'checksums': ['23128b136aed4e5121e793d1b6c60ee50c8007a9d926c1313e524d05386b54ac'],
    }),
    ('gpgme', '1.23.2', {  # 2024-12-04
        'source_urls': ['https://www.gnupg.org/ftp/gcrypt/gpgme/'],
        'checksums': ['9499e8b1f33cccb6815527a1bc16049d35a6198a6c5fae0185f2bd561bce5224'],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/gpg',
        'bin/gpgconf',
        'bin/gpgrt-config',
        'include/gpg-error.h',
        'include/gcrypt.h',
        'include/gpgrt.h',
        'include/gpgme.h',
        'include/npth.h',
        'include/assuan.h',
    ],
    'dirs': ['lib/pkgconfig'],
}

moduleclass = 'system'
