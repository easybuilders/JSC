easyblock = 'PythonBundle'

name = 'pulser'
version = '1.5.5'

homepage = 'https://github.com/pasqal-io/Pulser'
description = """Pulser-core provides the core
functionalities needed to create sequences with pulser."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

dependencies = [
    ('Python', '3.12.3'),
    ('Pillow-SIMD', '10.4.0'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),  # numpy
    ('matplotlib', '3.9.2', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('hatchling', '1.24.2'),
    ('poetry', '1.8.3'),
    ('qutip', '5.0.4'),
    ('pydantic', '2.9.1'),
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'sanity_pip_check': True,
    'download_dep_fail': True,
    'use_pip_for_deps': False,
}

