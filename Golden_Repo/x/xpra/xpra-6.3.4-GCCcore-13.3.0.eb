# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'xpra'
version = '6.3.4'

local_xprahtml5_version = 'd34a470520a628ac9717a74db172f6f96b0dec78'  # v18+fix

homepage = "http://www.xpra.org"
description = """Xpra is an open-source multi-platform persistent remote display server and client
for forwarding applications and desktop screens.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

# https://gitlab.alpinelinux.org/alpine/aports/-/blob/master/community/xpra/APKBUILD
builddependencies = [
    ('binutils', '2.42'),
    ('pkgconf', '2.2.0'),
    ('poetry', '1.8.3'),
    ('CMake', '3.30.3'),
    ('Meson', '1.4.0'),
    ('meson-python', '0.16.0'),
    ('patchelf', '0.18.0'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('X11', '20240607'),
    ('OpenGL', '2024a'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('PyCairo', '1.27.0'),
    ('PyGObject', '3.48.2'),
    ('GTK3', '3.24.42'),
    ('lz4', '1.9.4'),
    ('x265', '3.6'),
    ('libvpx', '1.14.1'),
    ('FFmpeg', '7.0.2'),
    ('GStreamer', '1.24.8'),
    ('libwebp', '1.4.0'),
    ('libpng', '1.6.43'),
    ('libspng', '0.7.4'),
    ('openh264', '2.6.0'),
    ('libjpeg-turbo', '3.0.1'),
    ('zlib', '1.3.1'),
    ('LibTIFF', '4.6.0'),
    ('nvidia-Video_Codec_SDK', '12.2.72', '', SYSTEM),
    ('freetype', '2.13.2'),
    ('libyuv', '20250211'),
    ('DBus', '1.15.8'),
    ('Xvfb', '21.1.14'),
    ('CUDA', '12', '', SYSTEM),
    ('PyCUDA', '2025.1', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('Brotli', '1.1.0'),
    ('Pillow-SIMD', '10.4.0'),
    ('xxHash', '0.8.3'),
    ('paramiko', '3.5.1'),
    ('PyYAML', '6.0.2'),
]

components = [
    ('images', '1.0', {
        'easyblock': 'Binary',
        'sources': [
            {'filename': 'background.jpg', 'extract_cmd': "cp %s %%(builddir)s/"},
        ],
        'checksums': [
            {'background.jpg': 'aa41491f226b9ba871032eb4b1daaf5430e7ef174b441f8010377aee9e6b43bd'},
        ],
    }),
]

use_pip = True

exts_list = [
    ('setuptools_scm', '8.1.0', {
        'checksums': ['42dea1b65771cba93b7a515d65a65d8246e560768a66b9106a592c8e7f26c8a7'],
    }),
    ('pyproject-metadata', '0.7.1', {
        'checksums': ['0a94f18b108b9b21f3a26a3d541f056c34edcb17dc872a144a15618fed7aef67'],
    }),
    ('dbus-python', '1.3.2', {
        'modulename': 'dbus',
        'checksums': ['ad67819308618b5069537be237f8e68ca1c7fcc95ee4a121fe6845b1418248f8'],
    }),
    ('pyxdg', '0.28', {
        'modulename': 'xdg',
        'checksums': ['3267bb3074e934df202af2ee0868575484108581e6f3cb006af1da35395e88b4'],
    }),
    ('ifaddr', '0.2.0', {
        'checksums': ['cc0cbfcaabf765d44595825fb96a99bb12c79716b73b44330ea38ee2b0c4aed4'],
    }),
    ('async-timeout', '4.0.3', {
        'checksums': ['4640d96be84d82d02ed59ea2b7105a0f7b33abe8703703cd0ab0bf87c427522f'],
    }),
    ('zeroconf', '0.127.0', {
        'checksums': ['1ec001989666be7f76630d6bb8b07fb3928d655fa79a1484674a776778c9a1b3'],
    }),
    ('pynvml', '11.5.3', {
        'checksums': ['183d223ae487e5f00402d8da06c68c978ef8a9295793ee75559839c6ade7b229'],
    }),
    (name, version, {
        'buildopts': (
            '--without-strict --without-uinput --with-Xdummy '
            '--with-nvenc --with-nvjpeg_encoder --with-enc_x264 '
        ),
        'installopts': "--with-tests --without-service --without-printing --without-docs ",
        'modulename': False,
        'patches': ['xpra-6.2.3-use_Xorg_on_PATH_first.patch'],
        'prebuildopts': "export INCLUDE_DIRS=${EBROOTBROTLI}/include && ",
        'preinstallopts': "export INCLUDE_DIRS=${EBROOTBROTLI}/include && ",
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/Xpra-org/%(name)s/archive/refs/tags/'],
        'use_pip': False,
        'checksums': [
            {'v%(version)s.tar.gz':
             '592d2d64918d6f5cd1ff8d006581464576537557c3e512b9dbb3bdce7c32298f'},
            {'xpra-6.2.3-use_Xorg_on_PATH_first.patch':
             '72dc64a2260e69b671738fc42726ac165038693dbc6c661b8315b84f8f908eb4'},
        ],
    }),
    ('xpra-html5', local_xprahtml5_version, {
        'modulename': False,
        'patches': [
            'xprahtml_v17_timeout.patch',
        ],
        'skipsteps': [
            'configure',
            'build',
            'install',
        ],
        'source_tmpl': '%s.tar.gz' % local_xprahtml5_version,
        'source_urls': ['https://github.com/Xpra-org/%(name)s/archive/'],
        'use_pip': False,
        'checksums': [
            {'%s.tar.gz' % local_xprahtml5_version: '05b314ac154725c7c7e2dd3fddc0987962b1c4dcb1793a1d08bf00b92e92670e'},
            {'xprahtml_v17_timeout.patch': 'beef903b304a54d6ba9037590b8b7c7cf8adcb60141fb175e0e4709696720e72'},
        ],
    }),

]

postinstallcmds = [
    # installing cuda-files of xpra
    (
        'pushd %%(builddir)s/xpra/xpra-%s && '
        'mkdir -p %%(installdir)s/share/xpra && '
        'cp -a fs/share/xpra/cuda %%(installdir)s/share/xpra/ && '
        'popd '
    ) % (version),
    # installing xpra-html5
    (
        'pushd %%(builddir)s/xprahtml5/xpra-html5-%s && '
        './setup.py install %%(installdir)s /share/xpra/www /etc/xpra/html5-client && '
        'popd && '
        'pushd %%(installdir)s/share/xpra/www && '
        'ln -sf ../../../etc/xpra/html5-client/default-settings.txt && '
        'popd'
    ) % (local_xprahtml5_version),
    # install background image
    (
        'mkdir -p %(installdir)s/share/xpra/www/ && '
        'rm -f %(installdir)s/share/xpra/www/background.jpg && '
        'mv %(installdir)s/background.jpg %(installdir)s/share/xpra/www/ '
    ),
    # set default configurations
    (
        'cat <<EOF > %(installdir)s/etc/xpra/html5-client/default-settings.txt\n'
        'blocked-hosts = xpra.org,www.xpra.org\n'
        '\n'
        'min-quality = 80\n'
        'min-speed = 30\n'
        'offscreen = false\n'
        'EOF'
    ),
    # set specific configurations
    (
        # fix the xvfb call
        r"sed -i '/^[[:space:]]* \"${XORG_CONFIG_PREFIX}/c\ "
        r"   \"%(installdir)s/etc/xpra/xorg.conf\"'"
        r"   %(installdir)s/etc/xpra/conf.d/55_server_x11.conf && "
        # initialize script that can modify the environment of the server
        'touch %(installdir)s/etc/xpra/server.env && '
        r"sed -i 's!^source =.*!source = %(installdir)s/etc/xpra/server.env!' "
        r"       %(installdir)s/etc/xpra/conf.d/60_server.conf && "
        # limit socket-dirs to /tmp
        r"sed -i 's/^socket-dirs =/#&/' "
        r"       %(installdir)s/etc/xpra/conf.d/10_network.conf && "
        r"sed -i 's/^#socket-dirs = \/tmp/socket-dirs = \/tmp/' "
        r"       %(installdir)s/etc/xpra/conf.d/10_network.conf && "
        # disable audio
        r"sed -i 's/^audio =.*/audio = no/' "
        r"       %(installdir)s/etc/xpra/conf.d/20_audio.conf && "
        # disable dbus
        r"sed -i '/^dbus-control =/c\dbus-control = no\\n\dbus = no' "
        r"       %(installdir)s/etc/xpra/conf.d/60_server.conf && "
        r"sed -i 's/^dbus-launch =.*/dbus-launch =/' "
        r"       %(installdir)s/etc/xpra/conf.d/60_server.conf && "
        # disable notifications
        r"sed -i 's/^notifications =.*/notifications = no/' "
        r"       %(installdir)s/etc/xpra/conf.d/05_features.conf && "
        # disable webcam
        r"sed -i 's/^webcam =.*/webcam = no/' "
        r"       %(installdir)s/etc/xpra/conf.d/35_webcam.conf "
    ),
    # make Xpra randomly choose a GPU for acceleration if present
    'mv %(installdir)s/bin/xpra %(installdir)s/bin/xpra.orig',
    'head -1 %(installdir)s/bin/xpra.orig > %(installdir)s/bin/xpra',
    (
        '{ cat >> %(installdir)s/bin/xpra; } << \'EOF\'\n'
        'from os import environ \n'
        'if not \'CUDA_VISIBLE_DEVICES\' in environ: \n'
        '  try: \n'
        '    from pycuda import driver \n'
        '    driver.init() \n'
        '    num_gpus = driver.Device.count() \n'
        '  except: \n'
        '    num_gpus = 0 \n'
        '\n'
        '  if num_gpus > 0: \n'
        '    from random import randint \n'
        '    active_gpuid=randint(0,num_gpus-1) \n'
        '    environ[\'CUDA_VISIBLE_DEVICES\'] = str(active_gpuid) \n'
        'EOF'
    ),
    'tail -n +2 %(installdir)s/bin/xpra.orig >> %(installdir)s/bin/xpra',
    'chmod +x %(installdir)s/bin/xpra',
]

modextravars = {
    'XPRA_SYSTEM_CONF_DIRS': '%(installdir)s/etc/xpra',
    'PYTHONWARNINGS': 'ignore::DeprecationWarning'  # ignore pkg_config-warning in xpra-script
}

sanity_check_paths = {
    'files': ['bin/xpra'],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'vis'
