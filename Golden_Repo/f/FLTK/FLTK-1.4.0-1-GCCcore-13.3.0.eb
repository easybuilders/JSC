# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'FLTK'
version = '1.4.0-1'

homepage = 'https://www.fltk.org'
description = """FLTK is a cross-platform C++ GUI toolkit for UNIX/Linux (X11), Microsoft Windows,
 and MacOS X. FLTK provides modern GUI functionality without the bloat and supports 3D graphics via OpenGL
 and its built-in GLUT emulation."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = [
    'https://github.com/%(namelower)s/%(namelower)s/releases/download/release-%(version)s/']
sources = ['%(namelower)s-%(version)s-source.tar.gz']
checksums = ['1cb612545fb15e880e92e4294b252a3b7edb150f7be1299c07f8b473b367c5a0']

configopts = '--enable-shared --enable-threads --enable-xft'

builddependencies = [
    ('binutils', '2.42'),
    ('groff', '1.23.0'),
]

dependencies = [
    ('OpenGL', '2024a'),
    ('libpng', '1.6.43'),
    ('libjpeg-turbo', '3.0.1'),
    ('xprop', '1.2.7'),
    ('zlib', '1.3.1'),
]

sanity_check_paths = {
    'files': ['bin/fltk-config', 'bin/fluid', 'lib/libfltk.a', 'lib/libfltk.%s' % SHLIB_EXT],
    'dirs': ['lib'],
}

moduleclass = 'vis'
