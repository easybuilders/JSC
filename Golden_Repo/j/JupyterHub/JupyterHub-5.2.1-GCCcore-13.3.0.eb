# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'JupyterHub'
version = '5.2.1'

homepage = 'https://jupyter.org'
description = """JupyterHub is a multiuser version of the Jupyter (IPython) notebook designed
 for centralized deployments in companies, university classrooms and research labs."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]
dependencies = [
    ('Python', '3.12.3'),
    ('IPython', '8.27.0'),
    ('bcrypt', '4.2.1'),  # for jupyterhub-nativeauthenticator
    # ('configurable-http-proxy', ''),
    ('OpenSSL', '3', '', SYSTEM),
    ('tornado', '6.4.1'),
    # ('PycURL', ''),  # optional, recommended with large number of users
    ('SQLAlchemy', '2.0.36'),
    ('ruamel.yaml', '0.18.6'),
    ('pydantic', '2.9.1'),
    ('jupyter-server', '2.15.0'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('certipy', '0.1.3', {
        'checksums': ['695704b7716b033375c9a1324d0d30f27110a28895c40151a90ec07ff1032859'],
