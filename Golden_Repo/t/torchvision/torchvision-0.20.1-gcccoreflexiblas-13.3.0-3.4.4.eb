# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
name = 'torchvision'
version = '0.20.1'

homepage = 'https://github.com/pytorch/vision'
description = " Datasets, Transforms and Models specific to Computer Vision"

toolchain = {'name': 'gcccoreflexiblas', 'version': '13.3.0-3.4.4'}

source_urls = ['https://github.com/pytorch/vision/archive']
sources = ['v%(version)s.tar.gz']
checksums = [
    {'v0.20.1.tar.gz': '7e08c7f56e2c89859310e53d898f72bccc4987cd83e08cfd6303513da15a9e71'},
]

builddependencies = [('CMake', '3.29.3')]

dependencies = [
    ('CUDA', '12', '', SYSTEM),
    ('Python', '3.12.3'),
    ('Pillow-SIMD', '10.4.0'),
    ('PyTorch', '2.5.1'),
]

moduleclass = 'vis'
