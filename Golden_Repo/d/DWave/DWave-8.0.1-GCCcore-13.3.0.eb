# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'DWave'
version = '8.0.1'

homepage = 'https://docs.ocean.dwavesys.com'
description = """Ocean software is a suite of tools D-Wave Systems for solving hard problems with quantum computers.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}


builddependencies = [
    ('binutils', '2.42'),
    # pydantic-core toml requires this version of maturin
    ('maturin', '1.6.0'),
    ('hatchling', '1.24.2'),
    ('Rust', '1.78.0'),
]


dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('networkx', '3.3'),
    ('Flask', '3.0.3'),
    ('pydantic', '2.9.1'),
    ('Python-bundle-PyPI', '2024.06'),
    ('meson-python', '0.16.0'),
]

