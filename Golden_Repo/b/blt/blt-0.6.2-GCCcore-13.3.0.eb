# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Tarball'

name = 'blt'
version = '0.6.2'

homepage = 'https://github.com/LLNL/blt'
description = """
A streamlined CMake build system foundation by LLNL for developing HPC software.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

github_account = 'LLNL'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['84b663162957c1fe0e896ac8e94cbf2b6def4a152ccfa12a293db14fb25191c8']

dependencies = [
    ('binutils', '2.42'),
]

sanity_check_paths = {
    'files': ['SetupBLT.cmake'],
    'dirs': ['cmake'],
}

moduleclass = 'tools'
