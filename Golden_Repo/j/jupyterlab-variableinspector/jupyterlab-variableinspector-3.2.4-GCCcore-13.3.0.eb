# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyterlab-variableinspector'
version = '3.2.4'

homepage = "https://github.com/jupyterlab-contrib/jupyterlab-variableInspector"

description = """
Variable Inspector extension for Jupyterlab
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('lckr_jupyterlab_variableinspector', version, {
        'checksums': ['9bad61401ef24cbdd4bc000d882038bbdd9d79550f624bd1930978dd56dddf7b'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
