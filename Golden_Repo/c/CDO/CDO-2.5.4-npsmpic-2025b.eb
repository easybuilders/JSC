# updated to version 2.4.4
# J. Sassmannshausen (Imperial College London, UK)
# Alex Domingo (Vrije Universiteit Brussel, BE)
# Maxim Masterov (SURF, NL)

easyblock = 'ConfigureMake'

name = 'CDO'
version = '2.5.4'


homepage = 'https://code.zmaw.de/projects/cdo'
description = """CDO is a collection of command line Operators to manipulate and analyse Climate and NWP model Data."""

toolchain = {'name': 'npsmpic', 'version': '2025b'}
toolchainopts = {'usempi': True}

source_urls = ['https://code.mpimet.mpg.de/attachments/download/30128/']
sources = [SOURCELOWER_TAR_GZ]
patches = [
    'Runstat.patch',
    'Vertstat.patch',
]
checksums = [
    {'cdo-2.5.4.tar.gz': 'c7fc17d3eda8c216edb2f5e36c8ab32bcaeeb6b6f16296246f065c576d4efad2'},
    {'Runstat.patch': '333ad11127d687da1fdde16343419f149ad8057dbbfedee6ca1ff782be3a977e'},
    {'Vertstat.patch': '33568682cc10081dc39955f2d9dfc51c49eb6a2a150789bce3e98a6797198057'},
]

builddependencies = [
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('cURL', '8.14.1'),
    ('ecCodes', '2.44.0'),
    ('FFTW', '3.3.10'),
    ('HDF5', '1.14.6'),
    ('libxml2', '2.14.3'),
    ('netCDF', '4.9.3'),
    ('PROJ', '9.6.2'),
    ('Szip', '2.1.1'),
    ('UDUNITS', '2.2.28'),
    ('util-linux', '2.41'),
]

# Build libcdi
configopts = "--enable-cdi-lib "

# Use dependencies from EasyBuild
configopts += "--with-curl=$EBROOTCURL --with-eccodes=$EBROOTECCODES --with-fftw3 --with-hdf5=$EBROOTHDF5 "
configopts += "--with-netcdf=$EBROOTNETCDF --with-proj=$EBROOTPROJ --with-szlib=$EBROOTSZIP "
configopts += "--with-udunits2=$EBROOTUDUNITS --with-util-linux-uuid=$EBROOTUTILMINLINUX "

# Make sure to add Fortran runtime libraries
configopts += 'LIBS="$LIBS -fortranlibs" '

sanity_check_paths = {
    'files': ['bin/cdo', 'lib/libcdi.a', 'lib/libcdi.%s' % SHLIB_EXT],
    'dirs': ['include'],
}

sanity_check_commands = [
    "cdo --version  2>&1 | grep 'Climate Data Operators version %(version)s'"]

moduleclass = 'data'
