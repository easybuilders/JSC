# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'CUDA-Python'
# Warning: major and minor versions of CUDA and CUDA-Python are tied
version = '13'
local_real_version = '13.0.2'

homepage = 'https://nvidia.github.io/cuda-python/'
description = f"""
Python bindings for CUDA

The real version of this package is {local_real_version}.
"""
github_account = 'NVIDIA'

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}

builddependencies = [
    ('Cython', '3.1.2'),
]
dependencies = [
    ('CUDA', '%(version_major)s', '', SYSTEM),
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),
]

exts_default_options = {
    'source_urls': ['https://github.com/%(github_account)s/cuda-python/archive'],
    'sources': [{
        'download_filename': f'v{local_real_version}.tar.gz',
        'filename': '%(name)s-%(version)s.tar.gz'
    }],
}
exts_list = [
    ('pyclibrary', '0.2.2', {
        'source_urls': [PYPI_SOURCE],
        'sources': [SOURCELOWER_TAR_GZ],
        'checksums': ['9902fffe361bb86f57ab62aa4195ec4dd382b63c5c6892be6d9784ec0a3575f7'],
    }),
    ('cuda-bindings', local_real_version, {
        'modulename': 'cuda.bindings',
        'start_dir': 'cuda_bindings',
        'checksums': ['c76f8acc6ea605dade333a59473d452a54bacd05b6ccef37b40693c3ffc76b69']
    }),
    ('cuda-core', '0.4.0', {
        'modulename': 'cuda.core',
        'start_dir': 'cuda_core',
        'checksums': ['c76f8acc6ea605dade333a59473d452a54bacd05b6ccef37b40693c3ffc76b69'],
        'preinstallopts': 'export CUDA_CORE_BUILD_MAJOR=%(cudaver)s && ',
    }),
    ('cuda-pathfinder', '1.3.1a0', {
        'modulename': 'cuda.pathfinder',
        'start_dir': 'cuda_pathfinder',
        'checksums': ['c76f8acc6ea605dade333a59473d452a54bacd05b6ccef37b40693c3ffc76b69']
    }),
    ('cuda-python', local_real_version, {
        'modulename': 'cuda',
        'start_dir': 'cuda_bindings',
        'checksums': ['c76f8acc6ea605dade333a59473d452a54bacd05b6ccef37b40693c3ffc76b69']
    }),
]

sanity_check_commands = [
    "python -sc 'from cuda.bindings import driver, nvrtc'",
]

moduleclass = 'lib'
