# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'MakeCp'

name = 'blt'
version = '0.7.1'

homepage = 'https://github.com/LLNL/blt'
description = """
A streamlined CMake build system foundation by LLNL for developing HPC software.
BLT makes it easy to get up and running on a wide range of HPC compilers,
operating systems and technologies.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = ['https://github.com/LLNL/blt/archive/refs/tags/']
sources = ['v%(version)s.tar.gz']
patches = ['blt-cuda13-compatibility_pull731.patch']
checksums = [
    '136765087b78da96dff77dfd6eb9a1238dbfb67da9c7474bc8fb8532fc8ee015',
    'f89495bb749eb18500934eb3bc065b7c26b79e2f3a0237bfbe458b970c050c25',
]

builddependencies = [('binutils', '2.44')]

skipsteps = ['build']

files_to_copy = [
    'cmake',
    'share',
    'tests',
    'thirdparty_builtin',
    'SetupBLT.cmake',
    'LICENSE',
    'RELEASE-NOTES.md',
]

sanity_check_paths = {
    'files': ['SetupBLT.cmake'],
    'dirs': ['cmake'],
}

moduleclass = 'tools'
