# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'bqplot'
version = '0.13.0rc0'

homepage = "https://bqplot.github.io/bqplot"

description = """
bqplot is a 2-D visualization system for Jupyter, based on the constructs of the Grammar of Graphics.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
    ('nodejs', '20.13.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('JupyterLab', '4.3.4'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('traittypes', '0.2.1', {
        'checksums': ['be6fa26294733e7489822ded4ae25da5b4824a8a7a0e0c2dccfde596e3489bd6'],
    }),
    ('bqscales', '0.3.3', {
        'checksums': ['4a59cdc387563b345e77020dde40b297de6a56a918f7640638c4b7132a2a9342'],
    }),
    ('bqplot', version, {
        'checksums': ['d4c2939dccd3f24f4e202ed4a232fc434e60ec44441e57b734f7507ba3c45975'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
