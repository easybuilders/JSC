# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Bundle'

name = 'llvm-compilers'
version = '21.1.8'

homepage = 'https://llvm.org/'
description = """The LLVM Project is a collection of modular and reusable compiler
and toolchain technologies."""

toolchain = SYSTEM

local_gcc_version = '15.2.0'
dependencies = [
    ('GCCcore', local_gcc_version),
    ('binutils', '2.45', '', ('GCCcore', local_gcc_version)),
    ('LLVM', version, '', ('GCCcore', local_gcc_version)),
]

altroot = 'LLVM'
altversion = 'LLVM'

skipsteps = ['sanitycheck']

sanity_check_paths = {
    'files': [''],
    'dirs': [''],
}

# this bundle serves as a compiler-only toolchain, so it should be marked as compiler (important for HMNS)
moduleclass = 'compiler'
