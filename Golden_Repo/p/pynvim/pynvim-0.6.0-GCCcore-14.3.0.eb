# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'pynvim'
version = '0.6.0'

homepage = 'https://github.com/neovim/pynvim'
description = "Python client and plugin host for Nvim"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

github_account = 'neovim'
source_urls = [GITHUB_SOURCE]
sources = ['%(version)s.tar.gz']
checksums = ['6649d630ce4a94007fe69a8debb010c7b185057f36d61576d2542c90f3c8db99']

builddependencies = [
    ('binutils', '2.44'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('Python-bundle-PyPI', '2025.07'),
    ('Greenlet', '3.2.3'),
]

options = {'modulename': 'neovim'}

sanity_check_commands = ["python -c 'import neovim'"]

moduleclass = 'lib'
