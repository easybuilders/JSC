# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'libcdi'
version = '2.3.0'

homepage = 'https://gitlab.dkrz.de/mpim-sw/libcdi'
description = """
CDI is a C and Fortran Interface to access Climate model Data.
Supported data formats are GRIB, netCDF, SERVICE, EXTRA and IEG.
"""

toolchain = {'name': 'gpsmpi', 'version': '2024a'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://gitlab.dkrz.de/mpim-sw/libcdi/-/archive/cdi-%(version)s/']
sources = ['libcdi-cdi-%(version)s.tar.gz']
patches = ['stdbool.patch']
checksums = [
    {'libcdi-cdi-2.3.0.tar.gz': '233312591757fe882c579346726ffbf64327277dd00890736ee7dc164dc20280'},
    {'stdbool.patch': 'fe595bbe1b37b9ac6ebc90ad112202c5ddc88d8ae4245daab8eca33c471ffd80'},
]

start_dir = 'libcdi-cdi-%(version)s'

builddependencies = [
    ('Autoconf', '2.72'),
    ('Ruby', '3.4.1'),
    ('pkgconf', '2.2.0'),
]

dependencies = [
    ('ecCodes', '2.39.0'),
    ('netCDF', '4.9.2'),
    ('YAXT', '0.11.3'),
    ('SZ', '2.1.12.5'),
]

preconfigopts = "./autogen.sh && "

configopts = "--enable-openmp --with-grib_api=yes --disable-cgribex "
configopts += "--with-eccodes=${EBROOTECCODES} "
configopts += "--with-netcdf=${EBROOTNETCDF} "
configopts += "--with-szlib=${EBROOTSZ} "
configopts += "--enable-iso-c-interface "
configopts += "--enable-mpi "

modextravars = {'CDI_DIR': '%(installdir)s/lib/cmake/cdi/'}

sanity_check_paths = {
    'files': ['include/cdi.h', 'lib/libcdi.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'tools'
