# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
# with thanks to akesandgren for the easyconfig for 2022a
# updated for 2022b by BEAR Software team at University of Birmingham
# update to v2.5.0 for GCC/12.3.0 by Pavel Tománek (Inuits)

easyblock = 'CMakeMake'

name = 'spglib'
version = '2.5.0'

homepage = 'https://spglib.github.io/spglib/'
description = """Spglib is a C library for finding and handling crystal symmetries.
 This version also includes the Fortran interface."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}

source_urls = ['https://github.com/spglib/spglib/archive']
sources = ['v%(version)s.tar.gz']
checksums = ['b6026f5e85106c0c9ee57e54b9399890d0f29982e20e96ede0428b3efbe6b914']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

configopts = '-DSPGLIB_SHARED_LIBS=ON -DSPGLIB_WITH_Fortran=ON  -DSPGLIB_USE_OMP=ON -DSPGLIB_WITH_TESTS=OFF '


postinstallcmds = [
    "cd %(installdir)s/include && mkdir spglib && ln -s ../spglib.h spglib/ ",
    "cd %(installdir)s/include && ln -s Spglib_Fortran/GNU-14.3.0/spglib_f08.mod spglib_f08.mod ",
]

sanity_check_paths = {
    'files': [
        'include/spglib.h',
        'include/Spglib_Fortran/GNU-14.3.0/spglib_f08.mod',
        'lib/libsymspg.%s' % SHLIB_EXT,
        'lib/libspglib_f08.%s' % SHLIB_EXT
    ],
    'dirs': [],
}

moduleclass = 'chem'
