# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'trame'
version = '3.8.0'

homepage = 'https://github.com/Kitware/trame'
description = """
A web framework that weaves together open source components into customized visual analytics easily.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.24.2'),
    ('hatch-jupyter-builder', '0.9.1'),  # for trame_jupyter_extension
]

dependencies = [
    ('Python', '3.12.3'),
    ('PyYAML', '6.0.2'),
    ('aiohttp', '3.10.10'),
    ('matplotlib', '3.9.2', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('JupyterLab', '4.3.4'),  # for trame_jupyter_extension
]

