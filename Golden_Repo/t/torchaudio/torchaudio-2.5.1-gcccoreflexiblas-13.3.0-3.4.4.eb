# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'torchaudio'
version = '2.5.1'

homepage = 'https://github.com/pytorch/audio'
description = """ Data manipulation and transformation for audio signal
processing, powered by PyTorch """

toolchain = {'name': 'gcccoreflexiblas', 'version': '13.3.0-3.4.4'}

# Torchaudio is completely dependent on the right version of PyTorch
# so we download from the same source_url as PyTorch

source_urls = ['https://download.pytorch.org/whl/cu124/']

if ARCH == 'aarch64':
    sources = ['%(name)s-%(version)s-cp312-cp312-linux_%(arch)s.whl']
    checksums = [
        'b5eeaeb2be9e980077e5713b689442e776bebfe1d836c0c507ae725772c8a8a2']
else:
    sources = ['%(name)s-%(version)s%2Bcu124-cp312-cp312-linux_%(arch)s.whl']
    checksums = [
        '9902598e0330aeead0bc1545837804eb268549b9b4ce41ae3ca51b2384904e89']

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-Stack', '2024a'),
    ('CUDA', '12', '', SYSTEM),
    ('PyTorch', '2.5.1'),
    ('SoX', '14.4.2'),
    ('zlib', '1.3.1'),
    ('bzip2', '1.0.8'),
    ('librosa', '0.10.2.post1'),
]
preinstallopts = 'export USE_FFMPEG=1; export TORCH_CUDA_ARCH_LIST=%(cuda_cc_semicolon_sep)s; '
installopts = '--no-use-pep517'

download_dep_fail = True
use_pip = True
sanity_pip_check = True

moduleclass = 'tools'
