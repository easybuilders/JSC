# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CargoPythonBundle'

name = 'qoqo-quest'
version = '0.16.1'
versionsuffix = '-CUDA-12'

homepage = 'https://github.com/HQSquantumsimulations/qoqo-quest'
description = """
qoqo-quest allows to simulate the execution of qoqo quantum circuits with the help of the QuEST quantum simulator. 
"""

toolchain = {'name': 'gpsfbf', 'version': '2024a'}
toolchainopts = {'pic': True}

builddependencies = [
    ('maturin', '1.6.0'),
    ('Rust', '1.78.0'),
    # For soupsieve:
    ('hatchling', '1.24.2'),
]

dependencies = [
    ('dill', '0.3.9'),
    ('SymEngine', '0.13.0'),
    ('sympy', '1.13.3',  '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('CUDA', '12', '', SYSTEM),
    ('cuQuantum-Python', '24.11.0', '-CUDA-%(cudaver)s'),
    ('Qiskit', '1.2.4', '-CUDA-%(cudaver)s'),
    # required by crystal_tools
    ('plotly.py', '5.24.1'),
    # required by build for pyproject_hooks:
    ('PDM', '2.18.2'),
    ('PyYAML', '6.0.2'),
    ('uv', '0.7.4'),
    # required for qoqo_myqlm:
    ('myqlm', '1.11.2'),
]

