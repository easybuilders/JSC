# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'JupyterKernel-PyHPC'
version = '2025'
local_jupyterver = '4.3.4'
versionsuffix = '-' + local_jupyterver

homepage = 'https://www.fz-juelich.de'
description = """
Special kernel for running HPC Python course on  Jupyter.
Project Jupyter exists to develop open-source software, open-standards, and services
for interactive computing across dozens of programming languages.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    # just ensure they exist
    ('CUDA', '12', '', SYSTEM),
    ('CMake', '3.30.3'),
    ('Graphviz', '12.2.1'),
    ('SciPy-Stack', '2024a', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('numba', '0.60.0'),
    ('dask', '2024.9.1', '-serial', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('jupyter-server', '2.15.0'),
    ('ipyparallel', '9.0.0'),
    ('cuTENSOR', '2.0.2.5', '-CUDA-%(cudaver)s', SYSTEM),
    ('NCCL', 'default', '-CUDA-%(cudaver)s'),
    ('cuDNN', '9.5.0.50', '-CUDA-%(cudaver)s', SYSTEM),
    ('CuPy', '13.3.0', '-CUDA-%(cudaver)s', ('gcccoreflexiblas', '13.3.0-3.4.4')),
]

dependencies = [
    ('Python', '3.12.3'),
    ('JupyterLab', local_jupyterver),
]

components = [
    ('logos', '1.0', {
        'easyblock': 'Binary',
        'sources': [
            {'filename': 'logo-32x32.png', 'extract_cmd': "cp %s %%(builddir)s/"},
            {'filename': 'logo-64x64.png', 'extract_cmd': "cp %s %%(builddir)s/"},
            {'filename': 'logo-128x128.png', 'extract_cmd': "cp %s %%(builddir)s/"},
        ],
        'checksums': [
            {'logo-32x32.png': 'b2750aff264d4219602fa198c4baed8609f48825af6df8131283b8f603c41a57'},
            {'logo-64x64.png': 'd7bda7730acf25252c2c57cf56e680192d8eee9242464380a4c1f3b3d0a68c7a'},
            {'logo-128x128.png': '7510c74129dd2faa1b73bb923973c72f6f6b4b5427c80c88b7b1b326d2a4e0bd'},
        ],
    }),
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'sanity_pip_check': False,  # skip as it requires protobuf, TensorFlow
    'download_dep_fail': True,
    'use_pip_for_deps': False,
}

exts_list = [
    ('graphviz', '0.20.3', {
        'source_tmpl': 'graphviz-0.20.3-py3-none-any.whl',
        'checksums': ['81f848f2904515d8cd359cc611faba817598d2feaac4027b266aa3eda7b3dde5'],
    }),
    ('line-profiler', '4.2.0', {
        'source_tmpl': 'line_profiler-%(version)s-cp312-cp312-manylinux_2_17_x86_64.manylinux2014_x86_64.whl',
        'checksums': ['efcdbed9ba9003792d8bfd56c11bb3d4e29ad7e0d2f583e1c774de73bbf02933'],
    }),
]

local_kernel_dir = 'hpcpy'
local_kernel_name = 'hpcpy-%s' % version
local_kernel_display_name = 'HPC Python %s' % version

modextrapaths = {
    'JUPYTER_PATH': ['share/jupyter'],  # add search path for kernelspecs
}

# Ensure that the user-specific $HOME/.local/share/jupyter is always first entry in JUPYTHER_PATH
modluafooter = """
remove_path("JUPYTER_PATH", pathJoin(os.getenv("HOME"), ".local/share/jupyter"))
prepend_path("JUPYTER_PATH", pathJoin(os.getenv("HOME"), ".local/share/jupyter"))
"""

postinstallcmds = [
    # create kernel skeleton
    (
        'python -m ipykernel install --name=%s --prefix=%%(installdir)s && '
        'rm -f %%(installdir)s/share/jupyter/kernels/%s/logo-svg.svg && '
        'mv %%(installdir)s/logo-32x32.png   %%(installdir)s/share/jupyter/kernels/%s/logo-32x32.png && '
        'mv %%(installdir)s/logo-64x64.png   %%(installdir)s/share/jupyter/kernels/%s/logo-64x64.png && '
        'mv %%(installdir)s/logo-128x128.png %%(installdir)s/share/jupyter/kernels/%s/logo-128x128.png'
    ) % (local_kernel_dir, local_kernel_dir, local_kernel_dir, local_kernel_dir, local_kernel_dir),

    # write kernel.sh
    (
        '{ cat > %%(installdir)s/share/jupyter/kernels/%s/kernel.sh; } << EOF\n'
        '#!/bin/bash \n'
        '\n'
        '# Load required modules \n'
        'module purge \n'
        'module load Stages/${STAGE} \n'
        'module load GCC\n'
        'module load ParaStationMPI\n'
        'module load %s/%s%s \n'
        'module load CMake\n'
        'module load Graphviz\n'
        'module load SciPy-Stack\n'
        'module load numba\n'
        'module load dask\n'
        'module load mpi4py\n'
        'module load h5py\n'
        'module load jupyter-server\n'
        'module load ipyparallel/.9.0.0\n'
        'module load CUDA\n'
        'module load cuTENSOR\n'
        'module load NCCL\n'
        'module load cuDNN\n'
        'module load CuPy\n'
        '\n'
        'if [[ "${PROJECT}" ]]; then\n'
        '  export LD_LIBRARY_PATH=\$PROJECT/resources/code/text_stats/build:\$LD_LIBRARY_PATH\n'
        '  export LD_LIBRARY_PATH=\$PROJECT/resources/code/point/build:\$LD_LIBRARY_PATH\n'
        '  export PATH=\$PROJECT/packages/bin:\$PATH\n'
        'fi\n'
        '\n'
        'export HPCPY2025=1\n'
        '\n'
        'export PYTHONPATH=%%(installdir)s/lib/python%%(pyshortver)s/site-packages:\$PYTHONPATH \n'
        'exec python -m ipykernel \$@\n'
        '\n'
        'EOF'
    ) % (local_kernel_dir, name, version, versionsuffix),
    'chmod +x %%(installdir)s/share/jupyter/kernels/%s/kernel.sh' % local_kernel_dir,

    # write kernel.json
    (
        '{ cat > %%(installdir)s/share/jupyter/kernels/%s/kernel.json; } << \'EOF\'\n'
        '{ \n'
        '  "argv": [ \n'
        '    "%%(installdir)s/share/jupyter/kernels/%s/kernel.sh", \n'
        '    "-m", \n'
        '    "ipykernel_launcher", \n'
        '    "-f", \n'
        '    "{connection_file}" \n'
        '  ], \n'
        '  "display_name": "%s", \n'
        '  "language": "python", \n'
        '  "name": "%s", \n'
        '  "metadata": { \n'
        '    "debugger": true \n'
        '  } \n'
        '}\n'
        'EOF'
    ) % (local_kernel_dir, local_kernel_dir, local_kernel_display_name, local_kernel_name),
]

sanity_check_paths = {
    'files': [
        'share/jupyter/kernels/%s/kernel.sh' % local_kernel_dir,
        'share/jupyter/kernels/%s/kernel.json' % local_kernel_dir,
    ],
    'dirs': [
        'share/jupyter/kernels/',
    ],
}

moduleclass = 'tools'
