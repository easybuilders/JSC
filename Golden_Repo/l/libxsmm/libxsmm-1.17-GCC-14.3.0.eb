# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'libxsmm'
version = '1.17'

homepage = 'https://github.com/libxsmm/libxsmm'
description = """LIBXSMM is a library for small dense and small sparse matrix-matrix multiplications
targeting Intel Architecture (x86)."""

toolchain = {'name': 'GCC', 'version': '14.3.0'}


source_urls = ['https://github.com/libxsmm/libxsmm/archive/']
sources = ['%(version)s.tar.gz']

patches = ['libxsmm-1.17.patch']

checksums = [
    '8b642127880e92e8a75400125307724635ecdf4020ca4481e5efe7640451bb92',
    'b73f2a3e60b17202c85b6d5f9143a0e8ea8569e0462c924531d338c9c22dccdc',
]


skipsteps = ['configure']
maxparallel = 1

if ARCH == 'x86_64':
    local_options = 'MKL=1 ILP64=0 OPENBLAS=0 NOBLAS=0'
    builddependencies = [
        ('imkl', '2025.2.0', '', SYSTEM),
    ]
else:
    local_options = 'MKL=0 ILP64=0 OPENBLAS=1 NOBLAS=0'
    builddependencies = [
        ('OpenBLAS', '0.3.30'),
    ]

buildopts = [local_options + ' STATIC=1 ', local_options + ' STATIC=0 ']

# install both static and dynamic version
installopts = [
    'PREFIX=%(installdir)s ' + local_options + ' STATIC=1',
    'PREFIX=%(installdir)s ' + local_options + ' STATIC=0 '
]

runtest = local_options + ' tests'

sanity_check_paths = {
    'files': ['bin/libxsmm_gemm_generator', 'include/libxsmm.h', 'lib/libxsmm.a', 'lib/libxsmm.%s' % SHLIB_EXT],
    'dirs': ['share']
}

moduleclass = 'math'
