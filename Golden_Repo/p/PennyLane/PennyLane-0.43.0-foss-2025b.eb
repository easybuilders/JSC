postinstallcmds = [
    r"""
    for pkg in \
      pennylane_lightning \
      pennylane_lightning_kokkos \
      pennylane_lightning_tensor \
      pennylane_lightning_gpu
    do
        meta="%(installdir)s/lib/python%(pyshortver)s/site-packages/${pkg}-0.43.0.dist-info/METADATA"
        if [ -f "$meta" ]; then
            sed -i '/^Requires-Dist: scipy-openblas32/d' "$meta"
        fi
    done
    """
]

moduleclass = 'quantum'
