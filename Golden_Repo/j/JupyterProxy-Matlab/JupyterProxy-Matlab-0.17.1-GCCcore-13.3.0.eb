# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'JupyterProxy-Matlab'
version = '0.17.1'

# only users of the UNIX-group 'matlab' must have access
# group = 'matlab'

homepage = 'https://github.com/mathworks/jupyter-matlab-proxy'
description = """The MATLAB integration for Jupyter enables you to open a MATLAB desktop
in a web browser tab, directly from your Jupyter environment.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    ('hatchling', '1.24.2'),
    # check for existance
    # ('MATLAB', '2025b', '', ('gpsmpi', '2024a')),
    ('Xvfb', '21.1.14'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('jupyter-server-proxy', '20250303'),
    ('aiohttp', '3.10.10'),
]

exts_defaultclass = 'PythonPackage'
exts_default_options = {
    'download_dep_fail': True,
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
}

exts_list = [
    ('aiohttp_session', '2.12.1', {
        'checksums': [('sha256', '15e6e0288e9bcccd4b1d0c28aae9c20e19a252b12d0cb682223ca9c83180e899')],
    }),
    ('watchdog', '5.0.3', {
        'checksums': ['108f42a7f0345042a854d4d0ad0834b741d421330d5f575b81cb27b883500176'],
    }),
    ('matlab_proxy', '0.27.3', {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': [('sha256', '5640b9ff40a95657610fcb01cf4db9e321862b5ca5f5ed2d1df74cf1e6181f74')],
    }),
    ('jupyter_matlab_proxy', version, {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': [('sha256', '22b72debe11a26839dc9579cb4ed9d856b4b3b524e4f604aed7553b417daa333')],
    }),
]

postinstallcmds = [
    (
        '{ cat > %(installdir)s/bin/matlab; } << EOF \n'
        '#!/bin/bash \n'
        '\n'
        '# Load required modules \n'
        'module purge \n'
        'module load Stages/${STAGE} \n'
        'module load GCC \n'
        'module load ParaStationMPI \n'
        'module load MATLAB \n'
        'module load Xvfb/21.1.14 \n'
        '\n'
        'matlab "\\$@" \n'
        '\n'
        'EOF'
    ),
    'chmod +x %(installdir)s/bin/matlab',
    (
        '{ cat > %(installdir)s/bin/Xvfb; } << EOF \n'
        '#!/bin/bash \n'
        '\n'
        '# Load required modules \n'
        '# and ensure stderr stays empty as matlab-proxy seems to fail if not \n'
        'module purge 2>&1 \n'
        'module load Stages/${STAGE} 2>&1 \n'
        'module load GCC 2>&1 \n'
        'module load ParaStationMPI 2>&1 \n'
        'module load MATLAB 2>&1 \n'
        'module load Xvfb/21.1.14 2>&1 \n'
        '\n'
        'Xvfb "\\$@" 2>&1\n'
        '\n'
        'EOF'
    ),
    'chmod +x %(installdir)s/bin/Xvfb',
    # fix bug
    (
        "sed -i 's#^\\(\\s*icon_path = \\)\\(.*\\)#\\1str(\\2)#' "
        "    %(installdir)s/lib/python3.12/site-packages/jupyter_matlab_proxy/__init__.py"
    ),
]


modextravars = {
    'MWI_USE_EXISTING_LICENSE': 'True',
    'MWI_PROCESS_START_TIMEOUT': '600',
    'MWI_ENABLE_TOKEN_AUTH': 'True',
    # 'MWI_SHUTDOWN_ON_IDLE_TIMEOUT': '720'  # in minutes
    # 'MWI_ENABLE_WEB_LOGGING': 'True',
    # 'MWI_LOG_LEVEL': 'DEBUG',  # `NOTSET`, `DEBUG`, `INFO`, `WARN`, `ERROR`, or `CRITICAL`
    # 'MWI_LOG_FILE': '/tmp/matlab_proxy_logs.txt',
    # 'MWI_MATLAB_STARTUP_SCRIPT': ''
}

# Jupyter-matlab-kernel DISABLED:
# https://github.com/mathworks/jupyter-matlab-proxy/issues/62
modextrapaths = {
    # 'MWI_CUSTOM_MATLAB_ROOT': 'lib/python%(pyshortver)s/site-packages/jupyter_matlab_proxy/',
    # 'JUPYTER_PATH': ['share/jupyter'],  # add search path for kernelspecs
}

# Ensure that the user-specific $HOME/.local/share/jupyter is always first entry in JUPYTHER_PATH
# modluafooter = """
# remove_path("JUPYTER_PATH", pathJoin(os.getenv("HOME"), ".local/share/jupyter"))
# prepend_path("JUPYTER_PATH", pathJoin(os.getenv("HOME"), ".local/share/jupyter"))
# """

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'tools'
