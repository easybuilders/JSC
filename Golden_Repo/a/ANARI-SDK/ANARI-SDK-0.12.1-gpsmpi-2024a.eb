# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'ANARI-SDK'
version = '0.12.1'

homepage = 'https://github.com/KhronosGroup/ANARI-SDK'
description = """ANARI Software Development Kit (SDK)"""

toolchain = {'name': 'gpsmpi', 'version': '2024a'}
toolchainopts = {'pic': True}

github_account = 'KhronosGroup'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = [
    {'v%(version)s.tar.gz': '1fc5cf360b260cc2e652bff4a41dcf3507c84d25701dc6c6630f6f6f83656b6c'},
]

builddependencies = [
    ('CMake', '3.30.3'),
    ('pkgconf', '2.2.0'),
    ('Boost', '1.86.0')
]

dependencies = [
    ('Python', '3.12.3'),
    ('Embree', '4.3.3'),
    ('snappy', '1.2.1'),
]

separate_build_dir = True

configopts = "-DCMAKE_VERBOSE_MAKEFILE=ON "

configopts += "-DBUILD_HELIDE_DEVICE=ON "
configopts += "-DBUILD_REMOTE_DEVICE=ON "
configopts += "-DUSE_MPI=ON "

sanity_check_paths = {
    'files': [],
    'dirs': ['bin', 'include', 'lib']
}

moduleclass = 'tools'
