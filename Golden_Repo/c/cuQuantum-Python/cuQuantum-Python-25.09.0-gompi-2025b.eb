# required to detect libnvrtc.so.12:
modextrapaths = {
    'LD_LIBRARY_PATH': 'lib/python%(pyshortver)s/site-packages/nvidia/cuda_nvrtc/lib',
}

# Modify cuquantum_python_cu12 constraint METADATA, cupy 13.6.0 dependency works with cuquantum.
postinstallcmds = [
    "sed -i "
    "'s/^Requires-Dist: cupy-cuda12x.*/Requires-Dist: cupy>=13.0/' "
    "%(installdir)s/lib/python%(pyshortver)s/site-packages/"
    "cuquantum_python_cu12-25.9.0.dist-info/METADATA"
]

# Conflict with CUDA-Python:
# CUDA-Python-12: pyclibrary (0.2.2), cuda_bindings (12.9.2), cuda-pathfinder (1.1.0), cuda-core (0.3.1)
# CUDA-Python-13: pyclibrary (0.2.2), cuda_bindings (13.0.2), cuda-pathfinder (1.3.1a0) cuda-core (0.4.0)
# cuQuantum-Python: pyclibrary (0.3.0), cuda_bindings (12.9.4), cuda-pathfinder (1.2.3), cuda-core (0.3.2)
modluafooter = 'conflict("CUDA-Python")'

moduleclass = 'quantum'
