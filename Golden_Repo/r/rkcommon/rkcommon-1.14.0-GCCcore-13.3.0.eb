# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'rkcommon'
version = '1.14.0'

homepage = 'https://github.com/RenderKit/rkcommon'
description = """
Intel RenderKit common C++/CMake infrastructure
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

source_urls = ['https://github.com/ospray/rkcommon/archive/']
sources = ['v%(version)s.tar.gz']
checksums = ['5aef75afc8d4fccf9e70df4cbdf29a1b28b39ee51b5588b94b83a14c6a166d83']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.30.3'),
]

dependencies = [
    ('tbb', '2021.13.0'),
]

separate_build_dir = True

start_dir = '%(name)s-%(version)s'

sanity_check_paths = {
    'dirs': ['bin', 'include/rkcommon'],
    'files': ['lib/librkcommon.so'],
}

moduleclass = 'vis'
