# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'libyuv'
version = '20250211'

local_commit = '61354d2671d9b5c73cc964415fe25bc76cea051a'

homepage = 'https://chromium.googlesource.com/libyuv/libyuv/'
description = """
libyuv for colorspace conversion. libyuv is Optimized for SSE2/SSSE3/AVX2 on x86/x64.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

sources = [
    {
        'source_urls': ['https://chromium.googlesource.com/libyuv/libyuv/+archive/'],
        'filename': '%%(name)s-%s.tar.gz' % local_commit,
        'download_filename': '%s.tar.gz' % local_commit,
    }
]
# each download is slightly different in the meta-data
checksums = ['d8839aa333b02fdd743f23da79ecf5828f21ae3cf7decb6440ff4a4b5476f834']

builddependencies = [
    ('binutils', '2.42'),
    ('CMake', '3.30.3')
]

separate_build_dir = True
start_dir = './'

configopts = '-DCMAKE_VERBOSE_MAKEFILE=ON '

postinstallcmds = [
    (
        '{ cat >> %(installdir)s/libyuv.pc; } << \'EOF\'\n'
        'prefix=%(installdir)s\n'
        'exec_prefix=${prefix}\n'
        'libdir=${prefix}/lib\n'
        'includedir=${prefix}/include\n'
        '\n'
        'Name: libyuv\n'
        'Description: YUV conversion and scaling functionality library\n'
        'Version: 0\n'
        'Cflags: -I${includedir}\n'
        'Libs: -L${libdir} -lyuv\n'
        'EOF'
    ),
]

sanity_check_paths = {
    'files': ['lib/libyuv.a', 'include/libyuv.h'],
    'dirs': [],
}

modextrapaths = {
    'PKG_CONFIG_PATH': ''
}

moduleclass = 'vis'
