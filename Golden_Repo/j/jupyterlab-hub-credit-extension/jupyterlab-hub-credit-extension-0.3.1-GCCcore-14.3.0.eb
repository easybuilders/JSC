# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyterlab-hub-credit-extension'
version = '0.3.1'

homepage = "https://github.com/jsc-jupyter/jupyterlab-hub-credit-extension"

description = """
Jupyter extension to keep track of JupyterHub Credits
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('jupyter-server', '2.17.0'),
]

exts_list = [
    ('jupyterlab_hub_credit_extension', version, {
        'checksums': ['1df1d86d8b33277c6de9056645eacd42a197afea1820874a97367de11b3e6ed2'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
