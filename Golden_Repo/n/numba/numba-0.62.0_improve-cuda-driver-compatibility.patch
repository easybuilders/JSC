From a707d4a46c979698c428d289a71b091840d74a21 Mon Sep 17 00:00:00 2001
From: Stan Seibert <sseibert@anaconda.com>
Date: Thu, 18 Sep 2025 13:45:36 -0500
Subject: [PATCH 1/5] Backport of driver fix from NVIDIA/numba-cuda#185

---
 numba/cuda/cudadrv/driver.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/numba/cuda/cudadrv/driver.py b/numba/cuda/cudadrv/driver.py
index 875497e55d4..4170787411c 100644
--- a/numba/cuda/cudadrv/driver.py
+++ b/numba/cuda/cudadrv/driver.py
@@ -365,6 +365,9 @@ def _find_api(self, fname):
         else:
             variants = ('_v2', '')
 
+        if fname in ("cuCtxGetDevice", "cuCtxSynchronize"):
+            return getattr(self.lib, fname)
+
         for variant in variants:
             try:
                 return getattr(self.lib, f'{fname}{variant}')

