# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
name = 'psmpi'
version = '5.13.0-1'

homepage = 'https://github.com/ParaStation/psmpi2'
description = """ParaStation MPI is an open source high-performance MPI 4.0 implementation,
based on MPICH v3. It provides extra low level communication libraries and integration with
various batch systems for tighter process control.
"""

toolchain = {'name': 'intel-compilers', 'version': '2025.2.0'}

sources = [SOURCE_TAR_GZ]
source_urls = ['https://gitlab.jsc.fz-juelich.de/-/project/2121/uploads/953e95c3c2d40b663f67c8b141ecd3c9/']
patches = ['psmpi-5.13.0-1_fix-broken-ucc-configure.patch']
checksums = [
    {'psmpi-5.13.0-1.tar.gz': 'aa557bdcc814d6b8bc74b8266b75187b904a152b49b16c33636d98bf9f6cf079'},
    {'psmpi-5.13.0-1_fix-broken-ucc-configure.patch':
     'a22b6ebb91528904112fb51653a7fe34c378afeb4aeb1853aa8dd9154e4bf52a'},
]

builddependencies = [
    ('Autotools', '20250527'),
]

dependencies = [
    ('pscom', '6-default'),
    # needed due to the inclusion of hwloc
    ('libxml2', '2.14.3'),
    # Including CUDA here to trigger the hook to add the gpu property, and because it is actually needed
    ('CUDA', '13', '', SYSTEM),
    ('UCX', 'default'),
    ('PMIx', '5.0.8'),
    ('UCC', 'default'),
]

unrecognized_configure_options = 'warn'

preconfigopts = './autogen.sh && '

mpich_opts = '--enable-static --with-file-system=ufs+gpfs --enable-romio'

configopts = '--with-ucc=$EBROOTUCC --with-cuda-sm=%(cuda_int_comma_sep)s'

threaded = False

cuda = True

moduleclass = 'mpi'
