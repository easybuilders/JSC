# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'xeus'
version = '5.2.8'

homepage = 'https://github.com/jupyter-xeus/xeus'
description = """Implementation of the Jupyter kernel protocol in C++
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

github_account = 'jupyter-xeus'
source_urls = [GITHUB_SOURCE]
sources = ['%(version)s.tar.gz']
checksums = ['d1f00ba421c1f58901e2b30f6aafdf5f37f74492cf4b18a99aff36f51e5e1c94']

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('OpenSSL', '3', '', SYSTEM),
    ('ZeroMQ', '4.3.5'),
    ('nlohmann_json', '3.12.0'),
    ('cppzmq', '4.11.0'),
    ('xtensor', '0.27.1'),
]

separate_build_dir = True

configopts = "-DCMAKE_VERBOSE_MAKEFILE=ON "

sanity_check_paths = {
    'files': [
        'lib/libxeus.so'
    ],
    'dirs': ['include', 'lib']
}

moduleclass = 'tools'
