# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeNinja'
name = 'dftd4'
version = '3.7.0'

homepage = 'https://github.com/grimme-lab/xtb'
description = """DFT-D4 is semi-empirical generally applicable
atomic-charge dependent London dispersion correction model 
developed by the Grimme group in Bonn.

Usage: https://github.com/dftd4/dftd4 

This is currently configured for the use with CP2K.

"""

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}
toolchainopts = {'r8': True, 'openmp': True}
github_account = 'dftd4'
source_urls = [GITHUB_LOWER_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = ['f00b244759eff2c4f54b80a40673440ce951b6ddfa5eee1f46124297e056f69c']

builddependencies = [
    ('CMake', '4.0.3'),
    ('Ninja', '1.13.0'),
]

configopts = "-DCMAKE_PREFIX_PATH=${CMAKE_PREFIX_PATH}:${LAPACK_LIB_DIR} "

max_parallel = 1

test_cmd = 'OMP_NUM_THREADS=4 FLEXIBLAS_NUM_THREADS=4 ctest '
runtest = ' --test-dir . --parallel --output-on-failure '

sanity_check_paths = {
    'files': [
        'bin/dftd4', 'bin/mctc-convert', 'bin/mstore-fortranize', 'bin/mstore-info',
        'bin/multicharge', 'lib/libdftd4.a'
    ],
    'dirs': ['bin', 'lib64', 'include'],
}

modextravars = {
    'DFTD4HOME': '%(installdir)s',
}

moduleclass = 'chem'
