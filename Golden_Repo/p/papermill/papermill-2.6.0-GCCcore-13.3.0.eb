# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'papermill'
version = '2.6.0'

homepage = "https://github.com/nteract/papermill"

description = """
Parameterize, execute, and analyze notebooks.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('JupyterLab', '4.3.4'),
    ('tqdm', '4.66.5'),
    ('aiohttp', '3.10.10'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('entrypoints', '0.4', {
        'checksums': ['b706eddaa9218a19ebcd67b56818f05bb27589b1ca9e8d797b74affad4ccacd4'],
    }),
    ('ansicolors', '1.1.8', {
        'modulename': 'colors',
        'source_tmpl': '%(name)s-%(version)s.zip',
        'checksums': ['99f94f5e3348a0bcd43c82e5fc4414013ccc19d70bd939ad71e0133ce9c372e0'],
    }),
    ('tenacity', '9.0.0', {
        'patches': ['tenacity-9.0.0_fix_version.patch'],
        'preinstallopts': "sed -i 's/EB_TENACITY_VERSION/%(version)s/' setup.cfg && ",
        'checksums': [
            {'tenacity-9.0.0.tar.gz': '807f37ca97d62aa361264d497b0e31e92b8027044942bfa756160d908320d73b'},
            {'tenacity-9.0.0_fix_version.patch': '71a533470f03aab802439bda078494ab98804439afdb16f8287337bd3e0c8a82'},
        ],
    }),
    ('papermill', version, {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['0f09da6ef709f3f14dde77cb1af052d05b14019189869affff374c9e612f2dd5'],
    }),
]

moduleclass = 'tools'
