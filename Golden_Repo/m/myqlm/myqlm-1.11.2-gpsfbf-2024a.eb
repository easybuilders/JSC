# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CargoPythonBundle'

name = 'myqlm'
version = '1.11.2'

homepage = 'https://atos.net/en/lp/myqlm'
description = """myQLM is a quantum software stack for writing, simulating, optimizing, and executing quantum programs.
    myQLM also interfaces with the QLM, for Quantum Learning Machine, the quantum programming appliance of Atos."""

toolchain = {'name': 'gpsfbf', 'version': '2024a'}

# Comment: MyQLM didn't release aarch64 files. They are in process of building.
# In the meantime only x86_64 will be merged. JEDI installation will be blocked until June.
# No aarch64 files from MyQLM until June 2025.

builddependencies = [
    ('poetry', '1.8.3'),
    ('CMake', '3.29.3'),
    ('maturin', '1.6.0'),
    ('Rust', '1.78.0'),
    ('setuptools-rust', '1.9.0'),
    ('hatchling', '1.24.2'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),  # numpy
    ('dill', '0.3.9'),
    ('networkx', '3.3'),
    ('tqdm', '4.66.5'),
    ('matplotlib', '3.9.2', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('qutip', '5.0.4'),
    ('IPython', '8.27.0'),
    ('jax', '0.4.34', '-CUDA-12'),
    ('pulser', '1.3.0'),
    ('Qiskit', '1.2.4', '-CUDA-12'),
]

