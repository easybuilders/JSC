Prevent potential system overload on login nodes by removing the option for infinite jobs and capping the maximum number of jobs.
author: Sebastian Achilles (Juelich Supercomputing Centre)
--- make/src/main.c     2025-01-26 19:15:32.423918302 +0100
+++ make_mod/src/main.c 2025-04-14 11:41:16.669112437 +0200
@@ -228,7 +228,11 @@
 
 /* Value of job_slots that means no limit.  */
 
-static const int inf_jobs = 0;
+static const int inf_jobs = 1;
+
+/* Define the maximum allowed number of job slots.  */
+
+static const int max_jobs = 8;
 
 /* Authorization for the jobserver.  */
 
@@ -342,7 +346,8 @@
   -I DIRECTORY, --include-dir=DIRECTORY\n\
                               Search DIRECTORY for included makefiles.\n"),
     N_("\
-  -j [N], --jobs[=N]          Allow N jobs at once; infinite jobs with no arg.\n"),
+  -j [N], --jobs[=N]          Allow N jobs at once; 1 job with no arg;\n\
+                              maximum number of jobs limited.\n"),
     N_("\
   --jobserver-style=STYLE     Select the style of jobserver to use.\n"),
     N_("\
@@ -2157,6 +2162,35 @@
   }
 #endif /* __MSDOS__ || __EMX__ */
 
+  /* Limit the number of job slots on login nodes to prevent system overload
+   * If arg_job_slots exceeds the maximum allowed, cap it at max_jobs
+   */
+  const char *filePath = "/etc/FZJ/nodetype";
+  FILE *file = fopen(filePath, "r");
+
+  int found = 0;
+
+  if (file != NULL) {
+
+    char buffer[256];
+
+    while (fgets(buffer, sizeof(buffer), file)) {
+        if (strstr(buffer, "login") != NULL) {
+            found = 1;
+            break;
+        }
+    }
+
+    fclose(file);
+  } else {
+    found = 0;
+  }
+
+  if (found) {
+    if ( arg_job_slots > max_jobs )
+      arg_job_slots = max_jobs;
+  }
+
   /* Final jobserver configuration.
 
      If we have jobserver_auth then we are a client in an existing jobserver
