# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'

name = 'ANARI-SDK'
version = '0.15.0'

homepage = 'https://github.com/KhronosGroup/ANARI-SDK'
description = """ANARI Software Development Kit (SDK)"""

toolchain = {'name': 'gompi', 'version': '2025b'}
toolchainopts = {'pic': True}

github_account = 'KhronosGroup'
source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
checksums = [
    {'v%(version)s.tar.gz': '8fe0fa1a7eea6768fe69a46313ba405b62b2667b1bae5e843bc751a90a53fad3'},
]

builddependencies = [
    ('binutils', '2.44'),
    ('CMake', '4.0.3'),
    ('pkgconf', '2.4.3'),
    ('Boost', '1.88.0')
]

dependencies = [
    ('Python', '3.13.5'),
    # ('Embree', '4.4.1'),  # ANARI-SDK pulls its own Embree 4.3.3 for helide
    ('snappy', '1.2.2'),
]

separate_build_dir = True

configopts = "-DCMAKE_VERBOSE_MAKEFILE=ON "

# ANARI-SDK pulls its own Embree 4.3.3 for helide which does not support NEON2x fully, yet
if ARCH == 'aarch64':
    configopts += "-DBUILD_HELIDE_DEVICE=OFF "
else:
    configopts += "-DBUILD_HELIDE_DEVICE=ON "
configopts += "-DBUILD_REMOTE_DEVICE=ON "

configopts += "-DUSE_MPI=ON "

sanity_check_paths = {
    'files': [],
    'dirs': ['bin', 'include', 'lib']
}

moduleclass = 'tools'
