# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Binary'

name = 'Nsight-Systems'
version = '2024.7.1'
homepage = 'https://developer.nvidia.com/nsight-systems'
description = 'NVIDIA Nsight Systems is a system-wide performance analysis tool'

# GCCcore toolchain is not strictly necessary, but used to bring it to same level as Nsight Compute
toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

download_instructions = """Download %(name)s %(version)s from the NVIDIA website, which requires a NVIDIA
developer account:
1. Go to https://developer.nvidia.com/gameworksdownload
2. Find %(name)s %(version)s
3. Download "%(name)s %(version)s (Linux)". This may require logging in to your NVIDIA developer account.
"""
local_nsight_systems_arch = 'sbsa-' if ARCH == 'aarch64' else ''
sources = [{
    'filename': 'NsightSystems-linux-%spublic-%%(version)s.84-3512561.run' % local_nsight_systems_arch,
    'extract_cmd': '/bin/sh %s'
}]
checksums = ['2f872dea0427cf5104b53e86d637917ce6b6d277afaed8aabe8f0b21ec5ad080']
checksums = [{
    'NsightSystems-linux-public-%(version)s.84-3512561.run':
        '2872acf7b4d725346c3faaf94c93fc9bd03938045111672a8ba083e86175a9be',
    'NsightSystems-linux-sbsa-public-%(version)s.84-3512561.run':
        'f0dbe58e6da01942ddf8cf65a40118bec1d09162ea78a60add1f778ea983dc8e'
}]

dependencies = [
    ('X11', '20240607')
]

extract_sources = True
unpack_options = '--accept --nochown --noexec --nox11 --target %(builddir)s'

install_cmd = 'cp -r %(builddir)s/pkg/* %(installdir)s/ '
if ARCH == 'aarch64':
    install_cmd += '&& ln -s %(installdir)s/target-linux-sbsa-armv8/nsys %(installdir)s/bin/nsys'

local_target_arch_suffix = 'sbsa-armv8' if ARCH == 'aarch64' else 'x64' if ARCH == 'x86_64' else 'unknown'
local_host_arch_suffix = 'armv8' if ARCH == 'aarch64' else 'x64' if ARCH == 'x86_64' else 'unknown'

sanity_check_paths = {
    'files': ['bin/nsys', 'bin/nsys-ui'],
    'dirs': ['target-linux-%s' % local_target_arch_suffix, 'host-linux-%s' % local_host_arch_suffix]
}

modextravars = {
    'NSIGHT_DOC': '%(installdir)s/documentation/nsys-exporter'
}

modluafooter = """
add_property("arch","gpu")
"""

moduleclass = 'tools'
