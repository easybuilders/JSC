        'source_tmpl': '%%(name)s-%%(version)s-cp312-cp312-manylinux2014_%s.whl' % local_arch[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-cp312-cp312-manylinux2014_%s.whl'
