# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Bundle'
name = 'SciPy-Stack'
version = '2025b'

local_scipy_bundle_ver = '2025.07'
local_matplotlib_ver = '3.10.5'
local_seaborn_ver = '0.13.2'
local_sympy_ver = '1.14.0'
local_xarray_ver = '2025.10.0'
local_ipython_ver = '9.4.0'

homepage = 'http://www.scipy.org'
description = f"""SciPy Stack is a collection of open source software for scientific computing in Python.
SciPy Stack includes 
 - SciPy-bundle/{local_scipy_bundle_ver}
 - matplotlib/{local_matplotlib_ver}
 - Seaborn/{local_seaborn_ver}
 - sympy/{local_sympy_ver}
 - xarray/{local_xarray_ver}
 - IPython/{local_ipython_ver}
"""

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}

dependencies = [
    ("Python", "3.13.5"),
    ('Python-bundle-PyPI', '2025.07'),
    ('SciPy-bundle', local_scipy_bundle_ver),
    ('matplotlib', local_matplotlib_ver),
    ('Seaborn', local_seaborn_ver),
    ('sympy', local_sympy_ver),
    ('xarray', local_xarray_ver),
    ('IPython', local_ipython_ver),
]

sanity_check_paths = {
    'files': [],
    'dirs': ['../../SciPy-Stack'],
}

moduleclass = 'vis'
