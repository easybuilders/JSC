easyblock = 'MesonNinja'

name = 'OpenSlide'
version = '4.0.0'

homepage = 'https://openslide.org/'
description = """OpenSlide is a C library that provides a simple interface to
read whole-slide images (also known as virtual slides)."""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

source_urls = [GITHUB_SOURCE]
sources = ['v%(version)s.tar.gz']
patches = ['%(name)s-%(version)s_fix_fclose.patch']
checksums = [
    {'v4.0.0.tar.gz': '0845f3bc5db660ccff890602efc0167524f6269dd20c49a9a5b469658dbb603c'},
    {'OpenSlide-4.0.0_fix_fclose.patch': '9f5266c4c11584edb9a70d1e50cc8a9c69c96d34dab2d52ef423aa278e4029b6'},
]

builddependencies = [
    ('Autotools', '20231222'),
    ('M4', '1.4.19'),
    ('pkgconf', '2.2.0'),
    ('binutils', '2.42'),
    ('Meson', '1.4.0'),
    ('Ninja', '1.12.1'),
]

dependencies = [
    ('zlib', '1.3.1'),
    ('libpng', '1.6.43'),
    ('libjpeg-turbo', '3.0.1'),
    ('LibTIFF', '4.6.0'),
    ('OpenJPEG', '2.5.2'),
    ('libxml2', '2.12.7'),
    ('SQLite', '3.45.3'),
    ('cairo', '1.18.0'),
    ('Gdk-Pixbuf', '2.42.11'),
]

build_cmd = 'meson compile -C %(builddir)s/easybuild_obj'
# Easybuild adds stuff here from ninja
install_cmd = 'meson install -C  %(builddir)s/easybuild_obj #'

sanity_check_paths = {
    'files': [
        'bin/openslide-quickhash1sum',
        'bin/openslide-show-properties',
        'bin/openslide-write-png',
        'lib/libopenslide.%s' % SHLIB_EXT
    ],
    'dirs': ['include/openslide']
}


moduleclass = 'vis'
