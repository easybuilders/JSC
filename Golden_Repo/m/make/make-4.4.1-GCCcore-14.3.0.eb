# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'make'
version = '4.4.1'

homepage = 'https://www.gnu.org/software/make/make.html'
description = "GNU version of make utility"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

source_urls = [GNU_SOURCE]
sources = [SOURCE_TAR_GZ]
patches = ['make-4.4.1_remove_infinite_jobs.patch']

checksums = [
    {'make-4.4.1.tar.gz': 'dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3'},
    {'make-4.4.1_remove_infinite_jobs.patch': '78759b979ee04ff89b231c0ae5797165ba4c3ae69ef7bac21aa45eb2aa426d3b'},
]

builddependencies = [('binutils', '2.44')]

postinstallcmds = ["cd %(installdir)s/bin && ln -s make gmake"]

sanity_check_paths = {
    'files': ['bin/gmake', 'bin/make'],
    'dirs': []
}

sanity_check_commands = [
    "gmake --help",
    "make --help",
]

moduleclass = 'devel'
