        'preinstallopts': "set -e; export SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PENNYLANE=0.43.0 && ",
        'source_tmpl': 'v%(version)s.tar.gz',
        'source_urls': ['https://github.com/PennyLaneAI/pennylane/archive/refs/tags/'],
