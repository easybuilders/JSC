# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'tvb-ext-unicore'
version = '3.1.1'

homepage = "https://github.com/the-virtual-brain/tvb-ext-unicore"

description = """
This jupyter extension offers a UI component to monitor HPC jobs through Unicore interface.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('jupyter-server', '2.15.0'),
    ('JupyterLab', '4.3.4'),  # explicitly required
    ('pyunicore', '1.2.0'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('tvb_ext_unicore', '%(version)s', {
        'checksums': ['044b11589a193e6996978c06d7a7654e466afe14b40b7b0dd3ee2b49eeb2e1d8'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
