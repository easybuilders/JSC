# diff -Naur cdo-2.5.4/src/operators/Vertstat.cc_orig cdo-2.5.4/src/operators/Vertstat.cc
--- cdo-2.5.4/src/operators/Vertstat.cc_orig	2026-01-23 14:15:59.171186000 +0100
+++ cdo-2.5.4/src/operators/Vertstat.cc	2026-01-23 14:19:56.506981362 +0100
@@ -314,8 +314,12 @@
           {
             if (rsamp1.empty()) rsamp1.resize(gridsize, rvar1.nsamp);
 
-            auto func = [&](auto const &v1, auto &v2, std::decay_t<decltype(v1[0])> missval)
+            // auto func = [&](auto const &v1, auto &v2, std::decay_t<decltype(v1[0])> missval)
+            auto func = [&](auto const &v1, auto &v2, auto missvaltype)	      
             {
+	      using T = std::decay_t<decltype(v1[0])>;
+	      T missval = missvaltype;
+	      
               for (size_t i = 0; i < gridsize; ++i)
                 if (fp_is_not_equal(v1[i], missval)) { v2[i] += layerWeight; }
             };
