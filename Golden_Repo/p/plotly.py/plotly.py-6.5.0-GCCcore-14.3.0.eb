# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'plotly.py'
version = '6.5.0'

homepage = 'https://plot.ly/python'
description = "An open-source, interactive graphing library for Python"

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatchling', '1.27.0'),
]
dependencies = [
    ('Python', '3.13.5'),
]

local_kaleido = {
    'aarch64': 'manylinux2014_aarch64',
    'x86_64':  'manylinux1_x86_64'
}

exts_list = [
    ('tenacity', '9.1.2', {
        'patches': ['tenacity-9.0.0_fix_version.patch'],
        'preinstallopts': "sed -i 's/EB_TENACITY_VERSION/%(version)s/' setup.cfg && ",
        'checksums': [
            {'tenacity-9.1.2.tar.gz': '1169d376c297e7de388d18b4481760d478b0e99a777cad3a9c86e556f4b697cb'},
            {'tenacity-9.0.0_fix_version.patch': '71a533470f03aab802439bda078494ab98804439afdb16f8287337bd3e0c8a82'},
        ],
    }),
    ('narwhals', '2.12.0', {
        'checksums': ['075b6d56f3a222613793e025744b129439ecdff9292ea6615dd983af7ba6ea44'],
    }),
    ('plotly', version, {
        'checksums': ['d5d38224883fd38c1409bef7d6a8dc32b74348d39313f3c52ca998b8e447f5c8'],
    }),
    ('kaleido', '0.2.1', {
        'source_tmpl': '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido['aarch64']:
                '845819844c8082c9469d9c17e42621fbf85c2b237ef8a86ec8a8527f98b6512a',
            '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido['x86_64']:
                'aa21cf1bf1c78f8fa50a9f7d45e1003c387bd3d6fe0a767cfbbf344b95bdc3a8',
        }],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'vis'
