# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'CMakeMake'
name = 'xtb'
version = '6.6.1'

homepage = 'https://github.com/grimme-lab/xtb'
description = """The semiempirical extended tight binding code (xtb) 
is developed by the Grimme group in Bonn.
It implements the semiempirical quantum mechanical methods GFNn-xTB 
and offers a wide variety of applications.
Documentation can be found on https://xtb-docs.readthedocs.io/en/latest/

"""

toolchain = {'name': 'gcccoreflexiblas', 'version': '14.3.0-3.4.5'}
toolchainopts = {'r8': True, 'openmp': True}

source_urls = [
    'https://github.com/grimme-lab/xtb/archive/refs/tags/',
]

builddependencies = [
    ('CMake', '4.0.3'),
    ('Ninja', '1.13.0'),
]

sources = [
    {'download_filename': 'v%(version)s.tar.gz', 'filename': 'xtb-%(version)s.tar.gz'},
]

patches = [
    'xtb-6.6.1_compileroptions.patch',
]

checksums = [
    'df9a9fbcbf685a94ba6e1a97a6fe6a8530227ea380a1507cb758e72907542dfe',
    '38d376eaf1cf3e542b1abd967e9d5ed9deb93d9a2180437c8fec6e39379e01b2',
]

# xtb-6.6.1 is fairly stable but still contains a number of minor bugs 
# In contrast to the upstream repo, this version can still be reliably built
# with CMake without an endless number of explicit dependencies 
# In contrast xtb-6.7.1 requires multiple fixes concerning subpackages 
# and still does not build properly => wait for an updated reliable version.


build_cmd = 'cmake --build . '
install_cmd = 'cmake --install . '

configopts = "-DCMAKE_DIALECT='-ffree-line-length-none -fbacktrace' -DCMAKE_Fortran_FLAGS_RELEASE='-O2'"
configopts += " -Dlapack='custom' -Dcustom_libraries='flexiblas' -G Ninja"


max_parallel = 1

test_cmd = 'OMP_NUM_THREADS=4 FLEXIBLAS_NUM_THREADS=1 ctest '
runtest = ' --test-dir . --parallel --output-on-failure '

sanity_check_paths = {
    'files': ['bin/xtb'],
    'dirs': ['bin', 'lib64', 'include', 'share/xtb'],
}

modextravars = {
    'XTBHOME': '%(installdir)s',
    'XTBPATH': '%(installdir)s',
}


moduleclass = 'chem'
