# Setting libcudaq_distributed_interface_mpi.so:
postinstallcmds = [
    (  # from %(installdir)s/lib/python%(pyshortver)s/site-packages/distributed_interfaces/activate_mpi_cutn.sh
        'cd %(installdir)s/lib/python%(pyshortver)s/site-packages/distributed_interfaces/ && '
        'mpicxx -shared -std=c99 -fPIC '
        '-I${EBROOTCUDA}/include -I../include '
        'mpi_comm_impl.cpp '
        '-o libcudaq_distributed_interface_mpi.so '
    ),
]


sanity_check_paths = {
    'files': [
        'lib/python%(pyshortver)s/site-packages/cudaq/__init__.py',
        'lib/python%(pyshortver)s/site-packages/distributed_interfaces/activate_custom_mpi.sh',
    ],
    'dirs': [
        'lib'
    ],
}

# aarch64 has an issue with LLVM, not GPU supported cudaQ for aarch64
# to be able to execute scripts this variable is required (tested scripts and worked)
if ARCH == "aarch64":
    modextravars = {
        'CUDAQ_MPI_COMM_LIB': (
            '%(installdir)s/lib/python%(pyshortver)s/site-packages/'
            'distributed_interfaces/libcudaq_distributed_interface_mpi.so'
        ),
        'CUDAQ_PLATFORM': 'qpp'
    }
if ARCH == "X86_64":
    modextravars = {
        'CUDAQ_MPI_COMM_LIB': (
            '%(installdir)s/lib/python%(pyshortver)s/site-packages/'
            'distributed_interfaces/libcudaq_distributed_interface_mpi.so'
        ),
    }

moduleclass = 'quantum'
