# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'plotly'
version = '5.22.0'

homepage = "https://plotly.com"

description = """
The interactive graphing library for Python.
"""

toolchain = {'name': 'GCCcore', 'version': '12.3.0'}

builddependencies = [
    ('binutils', '2.40'),
]

dependencies = [
    ('Python', '3.11.3'),
    ('JupyterLab', '4.2.1'),
]

sanity_pip_check = True
use_pip = True

local_kaleido = {
    'aarch64': 'manylinux2014_aarch64',
    'x86_64':  'manylinux1_x86_64'
}

exts_list = [
    ('tenacity', '8.3.0', {
        'checksums': ['953d4e6ad24357bceffbc9707bc74349aca9d245f68eb65419cf0c249a1949a2'],
    }),
    ('plotly', '%(version)s', {
        'checksums': ['859fdadbd86b5770ae2466e542b761b247d1c6b49daed765b95bb8c7063e7469'],
    }),
    ('kaleido', '0.2.1', {
        'source_tmpl': '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido[ARCH],
        'checksums': [{
            '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido['aarch64']:
                '845819844c8082c9469d9c17e42621fbf85c2b237ef8a86ec8a8527f98b6512a',
            '%%(name)s-%%(version)s-py2.py3-none-%s.whl' % local_kaleido['x86_64']:
                'aa21cf1bf1c78f8fa50a9f7d45e1003c387bd3d6fe0a767cfbbf344b95bdc3a8',
        }],
    }),
]

modextrapaths = {
    'JUPYTER_CONFIG_PATH': 'etc/jupyter',
    'JUPYTER_PATH': 'share/jupyter',
}

moduleclass = 'tools'
