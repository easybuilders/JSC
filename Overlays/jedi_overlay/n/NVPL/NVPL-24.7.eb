# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Bundle'

name = 'NVPL'
version = '24.7'

homepage = 'https://docs.nvidia.com/nvpl/'
description = """NVIDIA Performance Libraries (NVPL) are a collection
of essential mathematical libraries optimized for Arm 64-bit architectures.
NVPL allows you to easily port HPC applications to NVIDIA Grace™ CPU
platforms to achieve industry-leading performance and efficiency."""

toolchain = SYSTEM

source_urls = [
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_blas/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_common/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_fft/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_lapack/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_rand/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_sparse/linux-sbsa/',
    'https://developer.download.nvidia.com/compute/nvpl/redist/nvpl_tensor/linux-sbsa/',
]

default_easyblock = 'PackedBinary'

default_component_specs = {
    'sources': ['%(name)s-linux-sbsa-%(version)s-archive.tar.xz'],
    'start_dir': '%(name)s-linux-sbsa-%(version)s-archive',
    'install_cmd': 'cp -a %(start_dir)s/* %(installdir)s',
}

components = [
    ('nvpl_blas', '0.3.0', {
        'checksums': ['b51cb199a440c1e8673d3d845d395950c9a9020d4e83af2655eb96c23c6ec90d'],
    }),
    ('nvpl_common', '0.3.0', {
        'checksums': ['3019e73b6ea93ea41113fa6aab268ff1e76c706c2b5fea6a9a033b177e30fbbf'],
    }),
    ('nvpl_fft', '0.3.0', {
        'checksums': ['e20791b77fa705e5a4f7aa5dada39b2a41e898189e0e60e680576128d532269b'],
    }),
    ('nvpl_lapack', '0.2.3.1', {
        'checksums': ['25927df133c5486fd71d5976c93917c96e62275a78dffc354bcaf1b022f56f8e'],
    }),
    ('nvpl_rand', '0.5.0', {
        'checksums': ['71297d2450956872ed9723b5187e1d900e6e59fe3b4bfc30e5a171592b044fe7'],
    }),
    ('nvpl_sparse', '0.3.0', {
        'checksums': ['27fe32b7da18b1be13e95402188bfb0248709a466692d7a6ee92957344b42dfb'],
    }),
    ('nvpl_tensor', '0.2.0', {
        'checksums': ['74b0752772e6dd561d030d39739cca6ffc77b5b19abb1e9a9db9700c487d56d6'],
    }),
]


sanity_check_paths = {
    'files': ['lib/libnvpl_%s.so' % x for x in ['blas_core', 'fftw', 'lapack_core', 'rand', 'sparse', 'tensor']] +
             ['include/nvpl_%s.h' % x for x in ['blas', 'fftw', 'lapack', 'rand', 'sparse', 'tensor']],
    'dirs': ['include', 'lib'],
}

moduleclass = 'numlib'
