# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'tensorboard'
version = '2.18.0'

homepage = 'https://github.com/tensorflow/tensorboard'
description = """TensorBoard is a suite of web applications for inspecting and
understanding your TensorFlow runs and graphs."""

toolchain = {'name': 'gcccoreflexiblas', 'version': '13.3.0-3.4.4'}

builddependencies = [
    ('poetry', '1.8.3'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05'),
    ('protobuf-python', '5.28.0'),
    ('grpcio', '1.67.1'),
    ('Markdown', '3.7'),
    ('absl-py', '2.1.0')
]

use_pip = True
sanity_pip_check = True

exts_list = [
    ('cachetools', '5.5.1', {
        'checksums': ['70f238fbba50383ef62e55c6aff6d9673175fe59f7c6782c7a0b9e38f4a9df95'],
    }),
    ('pyasn1_modules', '0.4.1', {
        'checksums': ['c28e2dbf9c06ad61c71a075c7e0f9fd0f1b0bb2d2ad4377f240d33ac2ab60a7c'],
    }),
    ('rsa', '4.9', {
        'checksums': ['e38464a49c6c85d7f1351b0126661487a7e0a14a50f1675ec50eb34d4f20ef21'],
    }),
    ('google_auth', '2.38.0', {
        'modulename': 'google.auth',
        'checksums': ['8285113607d3b80a3f1543b75962447ba8a09fe85783432a784fdeef6ac094c4'],
    }),
    ('tensorboard_data_server', '0.7.2', {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['7e0610d205889588983836ec05dc098e80f97b7e7bbff7e994ebb78f578d0ddb'],
    }),
    ('Werkzeug', '3.1.3', {
        'source_tmpl': '%(namelower)s-%(version)s.tar.gz',
        'checksums': ['60723ce945c19328679790e3282cc758aa4a6040e4bb330f53d30fa546d44746'],
    }),
    (name, version, {
        'source_tmpl': '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['107ca4821745f73e2aefa02c50ff70a9b694f39f790b11e6f682f7d326745eab'],
    }),
]

# This has to go after all the packages, and not on the package itself
postinstallpatches = ['tensorboard-2.18.0_fix_jupyter.patch']
checksums = [
    {'tensorboard-2.18.0_fix_jupyter.patch':
     '7fff44f9af0e6a21e4994c52233093b15add5cde6886b48b0a475b59cc488d13'},
]
use_pip = True
sanity_pip_check = True

moduleclass = 'lib'
