# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'SystemBundle'

name = 'psmpi-settings'
version = '5'
versionsuffix = 'UCX'

homepage = ''
description = 'This module loads the ParaStationMPI configuration. It enables UCX as a communication library.'

toolchain = SYSTEM

source_urls = []

sources = []
modextravars = {
    'PSP_OPENIB': '0',
    'PSP_UCP': '1',
    'PSP_HARD_ABORT': '1',
    'SLURM_MPI_TYPE': 'pspmix',
    # Workaround for "PSI: doSpawn: spawn to node XXXX failed". To be removed probably after the next psmgmt update
    'PSPMIX_ENV_TMOUT': '20',
    # Do not switch to synchronized communication for MPI_Gatherv() starting at 32
    # processes which then unfortunately leads to a deadlock due to a bug in the
    # interplay between MPICH and the PSP device of PSMPI at this point.
    'MPIR_CVAR_GATHERV_INTER_SSEND_MIN_PROCS': '-1',
}

moduleclass = 'system'
