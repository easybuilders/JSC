# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyterlab-code-formatter'
version = '3.0.3'

homepage = "https://jupyterlab-code-formatter.readthedocs.io/"

description = """
A JupyterLab plugin to facilitate invocation of code formatters.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('poetry', '2.1.3'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('jupyter-server', '2.17.0'),
    ('aiohttp', '3.12.15'),
    ('black', '26.1.0'),
]

exts_list = [
    ('mypy_extensions', '1.1.0', {
        'checksums': ['52e68efc3284861e772bbcd66823fde5ae21fd2fdb51c62a211403730b916558'],
    }),
    ('isort', '8.0.1', {
        'checksums': ['171ac4ff559cdc060bcfff550bc8404a486fee0caab245679c2abe7cb253c78d'],
    }),
    (name, version, {
        'checksums': ['179e3c85cf6c0fc3c321c84bae446f3a2ad517e26606989c9485ce72e6c781c5'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
