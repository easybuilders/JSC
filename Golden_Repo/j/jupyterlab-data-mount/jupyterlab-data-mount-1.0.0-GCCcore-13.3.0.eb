# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyterlab-data-mount'
version = '1.0.0'

homepage = "https://github.com/jsc-jupyter/jupyterlab-data-mount"

description = """
Jupyter extension to mount external data storage.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('jupyter-server', '2.15.0'),
]

sanity_pip_check = True
use_pip = True

exts_list = [
    ('jupyterlab_data_mount', version, {
        'checksums': ['815e28c423788f06d5a58cbe8f3ae76f2f9fa00c991708285491c59724cb4ab7'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
