# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'nest-simulator'
version = '3.9'

homepage = 'https://www.nest-simulator.org/'
description = """NEST is a simulator for spiking neural network models
that focuses on the dynamics, size and structure of neural systems
rather than on the exact morphology of individual neurons.
"""

toolchain = {'name': 'gpsmpi', 'version': '2025b'}
toolchainopts = {'pic': True, 'usempi': True}

builddependencies = [
    ('CMake', '3.31.8'),
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('libtool', '2.5.4'),
    ('Boost', '1.88.0'),
    ('HDF5', '1.14.6'),
    ('SciPy-bundle', '2025.07', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('GSL', '2.8'),
    ('mpi4py', '4.1.0'),
    ('SIONlib', '1.7.7', '-tools'),
    ('libneurosim', '1.2.0'),
    ('Flask', '3.1.1'),
    ('Cython', '3.1.2'),
]

components = [
    ('nest-simulator', '%s' % version, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://github.com/nest/nest-simulator/archive/'],
        'sources': ['v%s.tar.gz' % version],
        'checksums': ['8e67b9dcb72b029f24f3d70ff6d3dd64776dc21bf3e458c822c862677d67d076'],
        'separate_build_dir': True,
        'start_dir': 'nest-simulator-%s' % version,
        'configopts': (
            '-DCMAKE_VERBOSE_MAKEFILE=ON '
            '-Dwith-libraries=OFF '
            '-Dwith-warning=ON '
            '-Dwith-userdoc=OFF '
            '-Dwith-optimize=ON '
            '-Dwith-boost=ON '
            '-Dwith-python=ON '
            '-Dwith-openmp=ON '
            '-Dwith-mpi=ON '
            '-Dwith-gsl=ON '
            '-Dwith-hdf5=ON '
            '-Dwith-libneurosim=ON '
            '-Dwith-ltdl=ON '
            '-Dwith-music=OFF '
            '-Dwith-readline=ON '
            '-Dwith-sionlib=ON '
            '-DSIONLIB_LIBRARIES=${EBROOTSIONLIB}/lib/ '
        ),
        'postinstallcmds': (
            'ln -s %(installdir)s/lib64/ %(installdir)s/lib/ && '
        )
    })
]

exts_list = [
    ('restrictedpython', '8.1', {
        'modulename': 'RestrictedPython',
        'checksums': ['4a69304aceacf6bee74bdf153c728221d4e3109b39acbfe00b3494927080d898'],
    }),
    ('gunicorn', '25.1.0', {
        'checksums': ['1426611d959fa77e7de89f8c0f32eed6aa03ee735f98c01efba3e281b1c47616'],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/nest', 'bin/nest-server',
    ],
    'dirs': [
        'bin', 'include', 'lib', 'share',
        'lib/python%(pyshortver)s/site-packages/nest',
    ]
}

moduleclass = 'tools'
