# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'ipyparallel'
version = '9.0.2'

homepage = 'https://github.com/ipython/ipyparallel'
description = "IPython Parallel: Interactive Parallel Computing in Python."

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('JupyterLab', '4.5.5'),
    ('PyZMQ', '27.1.0'),
    ('IPython', '9.4.0'),
    ('tqdm', '4.67.1'),
]

exts_list = [
    (name, version, {
        'checksums': ['d992edd698a99d45f2d9059af1c9ae8f086d1aeedb3e80436029a2f28d069f83'],
    }),
]

postinstallcmds = [
    # Disable extensions we do not want to show up, but which we want to have installed
    'mkdir -p %(installdir)s/etc/jupyter/labconfig ',
    (
        '{ cat > %(installdir)s/etc/jupyter/labconfig/page_config.json; } << \'EOF\'\n'
        '{\n'
        '    "disabledExtensions": {\n'
        '        "ipyparallel-labextension": true\n'
        '    }\n'
        '}\n'
        'EOF'
    ),
]

sanity_check_paths = {
    'files': ['bin/ipcluster', 'bin/ipcontroller', 'bin/ipengine'],
    'dirs': ['etc/jupyter', 'share/jupyter'],
}

sanity_check_commands = ['ipcluster --help']

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
