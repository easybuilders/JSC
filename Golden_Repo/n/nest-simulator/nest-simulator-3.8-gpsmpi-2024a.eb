# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'nest-simulator'
version = '3.8'

homepage = 'https://www.nest-simulator.org/'
description = """NEST is a simulator for spiking neural network models
that focuses on the dynamics, size and structure of neural systems
rather than on the exact morphology of individual neurons.
"""

toolchain = {'name': 'gpsmpi', 'version': '2024a'}
toolchainopts = {'pic': True, 'usempi': True}

builddependencies = [
    ('CMake', '3.30.3'),
    ('pkgconf', '2.2.0'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('libtool', '2.4.7'),
    ('Boost', '1.86.0'),
    ('HDF5', '1.14.5'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('GSL', '2.8'),
    ('mpi4py', '4.0.1'),
    ('SIONlib', '1.7.7'),
    ('libneurosim', '1.2.0'),
    ('Flask', '3.0.3'),
]

components = [
    ('nest-simulator', '%s' % version, {
        'easyblock': 'CMakeMake',
        'source_urls': ['https://github.com/nest/nest-simulator/archive/'],
        'sources': ['v%s.tar.gz' % version],
        'checksums': ['eb255f8828be001abea0cddad2f14d78b70857fc82bece724551f27c698318c8'],
        'separate_build_dir': True,
        'start_dir': 'nest-simulator-%s' % version,
        'configopts': (
            '-DCMAKE_VERBOSE_MAKEFILE=ON '
            '-Dwith-libraries=OFF '
            '-Dwith-warning=ON '
            '-Dwith-userdoc=OFF '
            '-Dwith-optimize=ON '
            '-Dwith-boost=ON '
            '-Dwith-python=ON '
            '-Dwith-openmp=ON '
            '-Dwith-mpi=ON '
            '-Dwith-gsl=ON '
            '-Dwith-hdf5=ON '
            '-Dwith-libneurosim=ON '
            '-Dwith-ltdl=ON '
            '-Dwith-music=OFF '
            '-Dwith-readline=ON '
            '-Dwith-sionlib=ON '
            '-DSIONLIB_LIBRARIES=${EBROOTSIONLIB}/lib/ '
        ),
        'preinstallopts': (
            'ln -s %(installdir)s/lib64/ %(installdir)s/lib && '
        )
    })
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'use_pip': True,
    'sanity_pip_check': False,  # skip as it requires protobuf, TensorFlow
    'download_dep_fail': True,
    'use_pip_for_deps': False,
}

exts_list = [
    ('restrictedpython', '7.4', {
        'modulename': 'RestrictedPython',
        'checksums': ['81b62924713dbd280917fceaecaf210fef7a49dddf1a08c8c214a3613fbeb425'],
    }),
    ('gunicorn', '23.0.0', {
        'checksums': ['f014447a0101dc57e294f6c18ca6b40227a4c90e9bdb586042628030cba004ec'],
    }),
]

sanity_check_paths = {
    'files': [
        'bin/nest', 'bin/nest-server',
    ],
    'dirs': [
        'bin', 'include', 'lib', 'share',
        'lib/python%(pyshortver)s/site-packages/nest',
    ]
}

moduleclass = 'tools'
