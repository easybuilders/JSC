# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'jupyter-bokeh'
version = '4.0.5'

homepage = "https://github.com/bokeh/jupyter_bokeh"

description = """
An extension for rendering Bokeh content in JupyterLab notebooks.
"""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}

builddependencies = [
    ('binutils', '2.44'),
    ('hatch-jupyter-builder', '0.9.1'),
]

dependencies = [
    ('Python', '3.13.5'),
    ('jupyter-server', '2.17.0'),
    ('bokeh', '3.7.3', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),

    # for bokeh exports
    # https://chromedriver.storage.googleapis.com/114.0.5735.16/chromedriver_linux64.zip
    # ('ChromeDriver', '114.0.5735.16')
]

exts_list = [
    ('jupyter_bokeh', version, {
        'checksums': ['a33d6ab85588f13640b30765fa15d1111b055cbe44f67a65ca57d3593af8245d'],
    }),
]

modextrapaths = {'EB_ENV_JUPYTER_ROOT': ''}

moduleclass = 'tools'
