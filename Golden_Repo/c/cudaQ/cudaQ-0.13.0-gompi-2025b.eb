# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'cudaQ'
version = '0.13.0'

# Version suffix removed and _cu12 extensions used to follow Stages/2026
# extension calls. Correct CUDA/1X called. Hook selects CUDA/1X per system/stage
homepage = 'https://github.com/NVIDIA/cuda-quantum/'
description = """The CUDA-Q Platform for hybrid quantum-classical computers
enables integration and programming of quantum processing units (QPUs),
GPUs, and CPUs in one system."""

toolchain = {'name': 'gompi', 'version': '2025b'}
toolchainopts = {'pic': True}

builddependencies = [('poetry', '2.1.3'),]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07', '', ('gcccoreflexiblas', '14.3.0-3.4.5')),
    ('CUDA', '13', '', SYSTEM),
    ('cuQuantum-Python', '25.09.0'),
]

local_arch = {
    'aarch64': 'aarch64',
    'x86_64':  'x86_64'
}

local_arch_odds = {
    'aarch64': '2014_aarch64.manylinux_2_17_aarch64',
    'x86_64':  '2010_x86_64.manylinux_2_12_x86_64'
}

exts_list = [
    ('nvidia_curand_cu12', '10.3.9.90', {
        'source_tmpl': '%%(name)s-%%(version)s-py3-none-manylinux_2_27_%s.whl' % (local_arch[ARCH]),
        'modulename': 'nvidia.curand',
        'checksums': [{
            '%%(name)s-%%(version)s-py3-none-manylinux_2_27_%s.whl' % (local_arch['aarch64']):
                'dfab99248034673b779bc6decafdc3404a8a6f502462201f2f31f11354204acd',
            '%%(name)s-%%(version)s-py3-none-manylinux_2_27_%s.whl' % (local_arch['x86_64']):
                'b32331d4f4df5d6eefa0554c565b626c7216f87a06a4f56fab27c3b68a830ec9',
        }],
    }),
    ('nvidia_cuda_runtime_cu12', '12.8.90', {
        'source_tmpl': '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.manylinux_2_17_%s.whl'
        % (local_arch[ARCH], local_arch[ARCH]),
        'modulename': 'nvidia.cuda_runtime',
        'checksums': [{
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.manylinux_2_17_%s.whl'
            % (local_arch['aarch64'], local_arch['aarch64']):
                '52bf7bbee900262ffefe5e9d5a2a69a30d97e2bc5bb6cc866688caa976966e3d',
            '%%(name)s-%%(version)s-py3-none-manylinux2014_%s.manylinux_2_17_%s.whl'
            % (local_arch['x86_64'], local_arch['x86_64']):
                'adade8dcbd0edf427b7204d480d6066d33902cab2a4707dcfc48a2d0fd44ab90',
        }],
    }),
    ('astpretty', '3.0.0', {
        'checksums': ['b08c95f32e5994454ea99882ff3c4a0afc8254c38998a0ed4b479dba448dc581'],
    }),
    ('cuda_quantum_cu12', '0.13.0', {
        # from fource cudaq autodetects most recent CUDA (CUDA/13) hence calling cuda_quantum_cu13 and all
        # its _cu13.whl which cannot be called because Stages/2026 uses _cu12.whl and must be respected
        # for compatibility with PyQuantum Kernel
        'source_tmpl': '%%(name)s-%%(version)s-cp313-cp313-manylinux_2_27_%s.manylinux_2_28_%s.whl'
        % (local_arch[ARCH], local_arch[ARCH]),
        'modulename': 'cudaq',
        'checksums': [{
            '%%(name)s-%%(version)s-cp313-cp313-manylinux_2_27_%s.manylinux_2_28_%s.whl'
            % (local_arch['aarch64'], local_arch['aarch64']):
                '17bbe5862af745e9111f426c9e36d729d95abfb0df3dea97b4c18ad44abdf02e',
            '%%(name)s-%%(version)s-cp313-cp313-manylinux_2_27_%s.manylinux_2_28_%s.whl'
            % (local_arch['x86_64'], local_arch['x86_64']):
                '3cf33b9cba6da178ca4c0583b9f8019f65d0924c7617679a1527d65b573022b8',
        }],
    }),
]

# 1. Setting libcudaq_distributed_interface_mpi.so
# 2. Modify cuda_quantum_cu12 constraint METADATA, cupy 13.6.0 dependency works with cuquantum.
postinstallcmds = [
    (
        "cd %(installdir)s/lib/python%(pyshortver)s/site-packages/distributed_interfaces/ && "
        "mpicxx -shared -std=c99 -fPIC "
        "-I${EBROOTCUDA}/include -I../include "
        "mpi_comm_impl.cpp "
        "-o libcudaq_distributed_interface_mpi.so "
    ),
    (
        "sed -i "
        "'s/^Requires-Dist: cupy-cuda12x.*/Requires-Dist: cupy>=13.0/' "
        "%(installdir)s/lib/python%(pyshortver)s/site-packages/"
        "cuda_quantum_cu12-0.13.0.dist-info/METADATA"
    ),
]

sanity_check_paths = {
    'files': [
        'lib/python%(pyshortver)s/site-packages/cudaq/__init__.py',
        'lib/python%(pyshortver)s/site-packages/distributed_interfaces/activate_custom_mpi.sh',
    ],
    'dirs': [
        'lib'
    ],
}

modextravars = {
    'CUDAQ_MPI_COMM_LIB': (
        '%(installdir)s/lib/python%(pyshortver)s/site-packages/'
        'distributed_interfaces/libcudaq_distributed_interface_mpi.so'
    ),
}

moduleclass = 'quantum'
