# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'dask'
version = '2024.9.1'

homepage = 'https://dask.org/'
description = """ Dask natively scales Python. Dask provides advanced parallelism for analytics,
enabling performance at scale for the tools you love."""

toolchain = {'name': 'gpsmpi', 'version': '2024a'}

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('PyYAML', '6.0.2'),
    ('bokeh', '3.6.0', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
]

use_pip = True

