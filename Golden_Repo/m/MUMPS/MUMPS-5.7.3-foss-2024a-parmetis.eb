# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
name = 'MUMPS'
version = '5.7.3'
versionsuffix = '-parmetis'

homepage = 'https://graal.ens-lyon.fr/MUMPS/'
description = "A parallel sparse direct solver"

toolchain = {'name': 'foss', 'version': '2024a'}
toolchainopts = {'pic': True, 'usempi': True}

source_urls = ['https://coin-or-tools.github.io/ThirdParty-Mumps/']
sources = ['%(name)s_%(version)s.tar.gz']
checksums = [
    '84a47f7c4231b9efdf4d4f631a2cae2bdd9adeaabc088261d15af040143ed112'
]

dependencies = [
    ('SCOTCH', '7.0.5'),
    ('ParMETIS', '4.0.3'),
]

parallel = 1

prebuildopts = 'export FFLAGS="$FFLAGS -fallow-argument-mismatch" && '

buildopts = 'all SONAME_VERSION="%(version)s"'

moduleclass = 'math'
