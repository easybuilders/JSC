# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'PennyLane'
version = '0.39.0'
versionsuffix = '-CUDA-%(cudaver)s'

homepage = 'https://pennylane.ai/'
description = """
PennyLane is a cross-platform Python library for quantum computing,
quantum machine learning, and quantum chemistry. 
"""

toolchain = {'name': 'gpsfbf', 'version': '2024a'}
toolchainopts = {'pic': True}

builddependencies = [
    # required for rustwork:
    ('Rust', '1.78.0'),
    # For PennyLane-Lightning:
    ('CMake', '3.29.3'),
    # required for rustworkx:
    ('setuptools-rust', '1.9.0'),
    # For PennyLane-Lightning
    ('poetry', '1.8.3'),
    ('Ninja', '1.12.1'),
    ('Ninja-Python', '1.11.1.1'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('Python-bundle-PyPI', '2024.06'),
    ('flit', '3.9.0'),
    ('SciPy-bundle', '2024.05', '', ('gcccoreflexiblas', '13.3.0-3.4.4')),
    ('networkx', '3.3'),
    ('CUDA', '12', '', SYSTEM),
    ('cuQuantum-Python', '24.11.0', '-CUDA-%(cudaver)s'),
    ('pybind11', '2.12.0'),
]

use_pip = True

exts_list = [
    ('packaging', '24.1', {
        'checksums': ['026ed72c8ed3fcce5bf8950572258698927fd1dbda10a5e981cdf0ac37f4f002'],
    }),
    ('rustworkx', '0.15.1', {
        'checksums': ['0e0cc86599f979285b2ab9c357276f3272f3fcb3b2df5651a6bf9704c570d4c1'],
    }),
    ('cachetools', '5.5.0', {
        'checksums': ['2cc24fb4cbe39633fb7badd9db9ca6295d766d9c2995f245725a46715d050f2a'],
    }),
    ('autoray', '0.7.0', {
        'checksums': ['7829d21258512f87e02f23ce74ae5759af4ce8998069d2cce53468f1d701a219'],
    }),
    ('autograd', '1.7.0', {
        'checksums': ['de743fd368d6df523cd37305dcd171861a9752a144493677d2c9f5a56983ff2f'],
    }),
    ('PennyLane_Lightning', '0.39.0', {
        'checksums': ['a1db6069c7d97eea50846d5b51a3d9ae97539bf68ac480b5c9bea1eaa5e3f1d1'],
    }),
    (name, version, {
        'modulename': 'pennylane',
        'source_tmpl':
            '%(name)s-%(version)s-py3-none-any.whl',
        'checksums': ['e11928a8ffd652b9c1b4f11955b50210c3b637f36ee3d8cea64a3a9a6a830977'],
    }),
    # Plugings:
    ('PennyLane_Lightning_Tensor', '0.39.0', {
        # Juwels-booster doesn't have CUDA drivers in all nodes. Plugins cannot be imported.
        # Nonetheless juwels, jusuf, jedi, jureca do import the plugins. Setting modulename False
        # for a successful installation in juwels-booster ('pennylane_lightning.lightning_tensor'
        # pennylane_lightning.lightning_gpu, pennylane_lightning.lightning_kokkos)
        'modulename': False,
        'checksums': ['a27f261993579fddbcc4c1c5d0bd5e24b287eb3a51d22bbcb1b145ca371d34cd'],
    }),
    ('PennyLane_Lightning_GPU', '0.39.0', {
        'modulename': False,
        'checksums': ['7007adacd42692dcfa13f1712b7e503a9474085b87194421f4e533e40fbc30b9'],
    }),
    ('PennyLane_Lightning_Kokkos', '0.39.0', {
        'modulename': False,
        'checksums': ['aeb2f961cd18850fe4b73ae6545a2d029a3f9103875422546723936da8039b55'],
    }),
]

moduleclass = 'quantum'
