# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'ninja-python'
version = '1.13.0'

homepage = ''
description = """Ninja is a small build system with a focus on speed. This package provides the
Python interface of Ninja."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

builddependencies = [
    ('binutils', '2.45'),
    ('CMake', '4.2.1'),
    ('scikit-build-core', '0.12.2'),
    ('hatchling', '1.29.0'),  # for hatch-fancy-pypi-readme
]

dependencies = [
    ('Python', '3.14.2'),
]

exts_list = [
    ('ninja', version, {
        'checksums': ['4a40ce995ded54d9dc24f8ea37ff3bf62ad192b547f6c7126e7e25045e76f978'],
    }),
]

moduleclass = 'tools'
