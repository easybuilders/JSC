# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonBundle'

name = 'JupyterProxy-RStudio'
version = '2024.12.0'

homepage = 'https://github.com/jupyterhub/jupyter-rsession-proxy'
description = """
Jupyter proxy for RStudio sessions.
RStudio is an integrated development environment (IDE) for R.
"""

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}
toolchainopts = {'pic': True}

builddependencies = [
    ('binutils', '2.42'),
    # check for existance
    # ('RStudio-Server', '2024.12.0+467', '-Java-21-R-4.4.2'),
]

dependencies = [
    ('Python', '3.12.3'),
    ('jupyter-server-proxy', '20250303'),
]

use_pip = True
sanity_pip_check = True

exts_list = [
    ('jupyter_rsession_proxy', '2.3.0', {
        'checksums': ['826bc3678bcd7e815ff3592874c9599882c5a83da42381ddb9297a81601ac6c9'],
    }),
]

postinstallcmds = [
    'mkdir %(installdir)s/bin/',
    (
        '{ cat > %(installdir)s/bin/rserver; } << EOF \n'
        '#!/bin/bash \n'
        '\n'
        '# Load required modules \n'
        'module purge \n'
        'module load Stages/${STAGE} \n'
        'module load GCC \n'
        'module load ParaStationMPI \n'
        'module load RStudio-Server \n'
        '\n'
        'rserver "\$@" \n'
        '\n'
        'EOF'
    ),
    'chmod +x %(installdir)s/bin/rserver'
]

modextravars = {
    'RSERVER_TIMEOUT': '90',
    'JUPYTER_RSESSION_PROXY_THREAD_POOL_SIZE': '20',
    'JUPYTER_RSESSION_PROXY_USE_SOCKET': 'ON',
}

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

moduleclass = 'tools'
