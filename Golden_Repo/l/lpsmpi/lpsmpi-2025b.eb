# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'Toolchain'

name = 'lpsmpi'
version = '2025b'

homepage = '(none)'
description = """LLVM based compiler toolchain, including ParaStationMPI for MPI support."""

toolchain = SYSTEM

local_llvmver = '20.1.8'

dependencies = [
    ('llvm-compilers', local_llvmver),
    ('psmpi', '5.13.0-1', '', ('llvm-compilers', local_llvmver)),
]

moduleclass = 'toolchain'
