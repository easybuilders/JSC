# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'PythonPackage'

name = 'uv'
version = '0.7.4'
homepage = 'https://docs.astral.sh/uv/'
description = "An extremely fast Python package and project manager, written in Rust."

toolchain = {'name': 'GCCcore', 'version': '13.3.0'}

builddependencies = [
    ('binutils', '2.42'),
]

dependencies = [
    ('Python', '3.12.3'),
]

local_arch_uv = {
    'aarch64': '2_28_aarch64',
    'x86_64':  '2_17_x86_64.manylinux2014_x86_64'
}

download_dep_fail = True
use_pip = True
sanity_pip_check = True

sources = ['uv-0.7.4-py3-none-manylinux_%s.whl' % (local_arch_uv[ARCH])]

checksums = [{
    '%%(name)s-%%(version)s-py3-none-manylinux_%s.whl'
    % (local_arch_uv['aarch64']):
        '40b73b40d9bdc95e6f04472bd4264ab12a2a8f379df99329c9f670d6647715b2',
    '%%(name)s-%%(version)s-py3-none-manylinux_%s.whl'
    % (local_arch_uv['x86_64']):
        '6555b82afa27e6061ea12405027bf3f72b02da59c706e82fb1ce36710b1c431f',
}]

sanity_check_paths = {
    'files': ['bin/uv', 'bin/uvx'],
    'dirs': ['lib/python%(pyshortver)s/site-packages/'],
}

sanity_check_commands = ['uv --help', 'uvx --help']

moduleclass = 'tools'
