# This file is part of JSC's public easybuild repository (https://github.com/easybuilders/jsc)
easyblock = 'ConfigureMake'

name = 'libcdi'
version = '2.5.4'
versionsuffix = '-serial'

homepage = 'https://gitlab.dkrz.de/mpim-sw/libcdi'
description = """CDI is a C and Fortran Interface to access Climate model Data.
Supported data formats are GRIB, netCDF, SERVICE, EXTRA and IEG."""

toolchain = {'name': 'GCCcore', 'version': '14.3.0'}
toolchainopts = {'pic': True}

source_urls = [
    'https://gitlab.dkrz.de/mpim-sw/libcdi/-/archive/cdi-%(version)s/']
sources = ['libcdi-cdi-%(version)s.tar.gz']
checksums = ['6093f9c48116dd63299179ab968b23330c20e15789450a923fd6a74699d7c7d8']

start_dir = 'libcdi-cdi-%(version)s'

builddependencies = [
    ('Autoconf', '2.72'),
    ('binutils', '2.44'),
    ('Ruby', '3.4.7'),
    ('pkgconf', '2.4.3'),
]

dependencies = [
    ('netCDF', '4.9.3', '-serial'),
    ('ecCodes', '2.44.0', '-serial'),
    #    ('Szip', '2.1.1'),
]

preconfigopts = "./autogen.sh && "

configopts = "--disable-cgribex "
configopts += "--with-eccodes=${EBROOTECCODES} "
configopts += "--with-netcdf=${EBROOTNETCDF} "
configopts += "--with-szlib=${EBROOTSZIP} "
configopts += "--enable-iso-c-interface "

modextravars = {'CDI_DIR': '%(installdir)s/lib/cmake/cdi/'}

sanity_check_paths = {
    'files': ['include/cdi.h', 'lib/libcdi.%s' % SHLIB_EXT],
    'dirs': [],
}

moduleclass = 'tools'
